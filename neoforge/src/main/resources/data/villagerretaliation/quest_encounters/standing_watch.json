{
  "schema": "villagerretaliation:encounter/v1",
  "id": "villagerretaliation:standing_watch",
  "version": 11,
  "controller": "villagerretaliation:controlled",
  "waves": [
    {
      "id": "restless_dead",
      "members": [
        { "entity": "minecraft:zombie", "count": 2 }
      ],
      "delay_ticks": 0,
      "trigger": "all_defeated",
      "boss_bar_title": "Standing Watch - Restless Dead",
      "scene_actions": [
        { "id": "first_warning", "type": "notification", "text": "The first attackers are coming through the dark." }
      ]
    },
    {
      "id": "raider_captain",
      "members": [
        {
          "id": "raider_captain",
          "entity": "minecraft:pillager",
          "count": 1,
          "custom_name": "Raider Captain",
          "name_visible": true,
          "glowing": true,
          "persistent": true,
          "health": 40,
          "movement_speed": 0.32,
          "attack_damage": 8,
          "armor": 8,
          "knockback_resistance": 0.3,
          "boss": true,
          "boss_bar_color": "purple",
          "boss_bar_overlay": "notched_10"
        }
      ],
      "delay_ticks": 80,
      "trigger": "all_defeated",
      "boss_bar_title": "Standing Watch - Raider Captain",
      "equipment": {
        "mainhand": {
          "item": "minecraft:crossbow",
          "drop_chance": 0.0
        }
      },
      "dialogue_hook": { "id": "captain_arrives", "text": "The captain is here. Hold the line!" }
    }
  ],
  "spawn_mode": "raid_waves",
  "spawn_points": [
    { "id": "north_line", "actor": "watch_captain", "offset_x": 8, "offset_z": -8, "weight": 2 },
    { "id": "south_line", "actor": "watch_captain", "offset_x": -8, "offset_z": 8, "weight": 1 }
  ],
  "spawn_selection": "sequential",
  "allies": [
    {
      "id": "village_guard",
      "entity": "minecraft:iron_golem",
      "count": 1,
      "revivable": true,
      "revive_delay_ticks": 100,
      "replacement_policy": "missing_if_loaded",
      "cleanup_policy": "preserve",
      "affects_completion": true
    }
  ],
  "failure": {
    "on_player_death": "reset_wave",
    "on_protected_actor_death": "fail",
    "retry_delay_ticks": 200,
    "max_attempts": 3,
    "retain_defeated": false
  },
  "environment": {
    "cues": [
      {
        "id": "alarm_bell",
        "type": "sound",
        "sound": "minecraft:block.bell.use",
        "volume": 1.0,
        "pitch": 0.8
      },
      {
        "id": "watch_beacon",
        "type": "glowing_column",
        "particle": "minecraft:end_rod",
        "offset_y": 1,
        "count": 32,
        "height": 8
      }
    ],
    "temporary_blocks": [
      {
        "id": "watch_light",
        "block": "minecraft:light",
        "offset_y": 3
      }
    ]
  },
  "guidance": {
    "coordinate_message": "The watch needs you in {dimension}. Follow the encounter marker; exact coordinates appear once you are within discovery range.",
    "arrival_message": "You have reached the watch position. Hold the line.",
    "discovery_radius": 64,
    "arrival_radius": 8,
    "distance_tracker": true,
    "compass_target": true,
    "directional_particles": true,
    "hud_marker": true,
    "exact_coordinates": "after_discovery",
    "update_interval_ticks": 20
  },
  "rewards": {
    "waves": [
      { "id": "captain_wave_supplies", "wave": "raider_captain", "item": "minecraft:arrow", "count": 4 }
    ],
    "phases": [
      { "id": "captain_phase_token", "phase": "captain_falls", "item": "minecraft:iron_nugget", "count": 2 }
    ],
    "completion": [
      { "id": "watch_medal", "item": "minecraft:emerald", "trophy_name": "Standing Watch Medal" }
    ],
    "trophies": [
      { "id": "captain_insignia", "member": "raider_captain", "item": "minecraft:iron_nugget", "name": "Raider Captain's Insignia" }
    ],
    "drop_policy": "trophy_only"
  },
  "phases": [
    {
      "id": "captain_enters",
      "trigger": { "type": "wave_started", "wave": "raider_captain" },
      "actions": [
        { "id": "warn_defenders", "type": "notification", "text": "The raider captain has entered the fight." }
      ]
    },
    {
      "id": "captain_falls",
      "trigger": { "type": "elite_defeated", "member": "raider_captain" },
      "actions": [
        { "id": "record_victory", "type": "fact", "scope": "quest", "tag": "villagerretaliation:standing_watch_captain_defeated" }
      ]
    }
  ],
  "boss_bar": true,
  "extra_per_player": 0,
  "max_party_size": 4,
  "placement_attempts": 24,
  "spawn_radius": 10,
  "area": {
    "radius": 32,
    "vertical_radius": 16,
    "leave_behavior": "warn",
    "leave_timeout_ticks": 200,
    "mob_behavior": "return"
  },
  "respawn_policy": "missing_if_loaded",
  "cleanup_policy": "remove_survivors",
  "completion_objectives": {
    "mode": "all",
    "objectives": [
      { "id": "clear_attackers", "type": "all_defeated" },
      { "id": "stop_captain", "type": "defeat_leader", "member": "raider_captain" }
    ]
  }
}
