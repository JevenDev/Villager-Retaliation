{
  "schema": "villagerretaliation:quest/v2",
  "id": "villagerretaliation:choose_the_soil",
  "metadata": {
    "title": "Choose the Soil",
    "description": "Choose whether the new field will rely on canals or compost.",
    "questline": "green_thumb",
    "parent": "villagerretaliation:new_furrows",
    "tags": [
      "group.green_thumb",
      "role.story",
      "feature.branching"
    ]
  },
  "provider": {
    "type": "villagerretaliation:villager",
    "filters": {
      "professions": [
        "minecraft:farmer"
      ],
      "min_villager_level": "apprentice",
      "skills": {
        "farming": {
          "min": 18
        }
      }
    }
  },
  "availability": {
    "repeatable": false,
    "max_starts": 1,
    "max_completions": 1,
    "abandonment": "allow_repickup",
    "consume_on_completion": true,
    "locked_to_villager": true,
    "cross_villager_compatible": false
  },
  "entry_stage": "choose",
  "stages": [
    {
      "id": "choose",
      "objectives": [
        {
          "id": "choose_route",
          "type": "choice",
          "key": "choice",
          "values": [
            "canal",
            "compost"
          ],
          "tracker": {
            "text": "Choose the route with the quest giver.",
            "complete_text": "Route chosen: {objective_choice_value}.",
            "show_progress": true,
            "progress": 0.2
          }
        }
      ],
      "complete_when": [
        "choose_route"
      ],
      "dialogue": {
        "offer": {
          "label": "Choose the Soil",
          "request": "question",
          "order": -22,
          "show_for_babies": false,
          "lines": [
            "The field can follow one permanent plan: canal work returns irrigation hardware, while compost work returns restorative food.",
            "Canals are material-heavy but steady. Compost is renewable, but demands more repeated labor. This choice closes the other field plan."
          ],
          "responses": [
            {
              "id": "canal",
              "label": "Build the canals",
              "text": "Canals, then. Give the water clean stone edges and no place to wander.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "canal"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose canals for the new field."
                }
              ],
              "transition": {
                "stage": "canal_work"
              }
            },
            {
              "id": "compost",
              "label": "Feed the soil",
              "text": "Compost, then. We will make the field rich before asking it for anything.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "compost"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose compost for the new field."
                }
              ],
              "transition": {
                "stage": "compost_work"
              }
            },
            {
              "id": "decline",
              "label": "Not yet.",
              "scene": "decline"
            }
          ]
        },
        "reminder": {
          "label": "About Choose the Soil",
          "request": "question",
          "order": -22,
          "show_for_babies": false,
          "lines": [
            "The field can follow one permanent plan: canal work returns irrigation hardware, while compost work returns restorative food.",
            "Canals are material-heavy but steady. Compost is renewable, but demands more repeated labor. This choice closes the other field plan."
          ],
          "responses": [
