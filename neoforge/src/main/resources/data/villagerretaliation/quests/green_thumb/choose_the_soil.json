    {
      "id": "canal_work",
      "objectives": [
        {
          "id": "lay_canal",
          "type": "block_place",
          "block": "minecraft:stone_bricks",
          "count": 12,
          "tracker": {
            "text": "Place 12 stone bricks for canal walls.",
            "complete_text": "The canal walls are laid.",
            "show_progress": true,
            "progress": 0.75
          }
        },
        {
          "id": "carry_water",
          "type": "item_check",
          "item": "minecraft:water_bucket",
          "count": 1,
          "consume": false,
          "tracker": {
            "text": "Carry a water bucket to fill the canal.",
            "complete_text": "The water bucket is ready.",
            "show_progress": true,
            "progress": 0.75
          }
        }
      ],
      "complete_when": [
        "lay_canal",
