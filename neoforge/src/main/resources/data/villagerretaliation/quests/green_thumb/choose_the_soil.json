                "unavailable": [
                  "That choice is not open right now."
                ]
              }
            }
          ]
        },
        {
          "id": "decline",
          "lines": [
            "Then the soil remains undecided, and undecided soil grows mostly weeds."
          ]
        }
      ],
      "ui": {
        "tracker_text": "Choose a route.",
        "show_progress": true,
        "progress": 0.2
      }
