        },
        {
          "id": "bring_bone_meal",
          "type": "item_check",
          "item": "minecraft:bone_meal",
          "count": 16,
          "tracker": {
            "text": "Bring 16 bone meal for the first rows.",
            "complete_text": "The bone meal is ready.",
            "show_progress": true,
            "progress": 0.75
