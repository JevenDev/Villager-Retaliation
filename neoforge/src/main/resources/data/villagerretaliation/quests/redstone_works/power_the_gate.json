      "id": "choose",
      "objectives": [
        {
          "id": "choose_route",
          "type": "choice",
          "key": "choice",
          "values": [
            "sunlight",
            "whisper"
          ],
          "tracker": {
            "text": "Choose the route with the quest giver.",
            "complete_text": "Route chosen: {objective_choice_value}.",
            "show_progress": true,
            "progress": 0.2
