      "dialogue": {
        "offer": {
          "label": "Power the Gate",
          "request": "question",
          "order": -22,
          "show_for_babies": false,
          "lines": [
            "The gate can follow daylight, or listen for footsteps through sculk. Both work, but they do not fail the same way.",
            "This choice closes the other design. Daylight stays local and pays modestly; sculk commits the next job to an Ancient City, with greater reputation and rare sculk rewards."
          ],
          "responses": [
            {
              "id": "sunlight",
              "label": "Follow the sun",
              "text": "Sunlight, then. The gate will keep honest hours and make its workings plain.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "sunlight"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose a daylight circuit for the village gate."
                }
              ],
              "transition": {
                "stage": "sunlight_work"
              }
            },
            {
              "id": "whisper",
              "label": "Listen through sculk",
              "text": "Sculk, then. The gate will listen, but wool must teach it what to ignore.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "whisper"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose a sculk circuit for the village gate."
                }
              ],
              "transition": {
                "stage": "whisper_work"
