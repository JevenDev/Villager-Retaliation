    "quest.workshop_oaths.temper_and_tally.stage.heat_stock.dialogue.reminder.lines": [
      "Iron and coal first. Heat without stock is only a way to sweat indoors."
    ],
    "quest.workshop_oaths.temper_and_tally.stage.heat_stock.dialogue.reminder.response.details.label": "Repeat the forge list.",
    "quest.workshop_oaths.temper_and_tally.stage.heat_stock.dialogue.reminder.response.leave.label": "I will bring it.",
