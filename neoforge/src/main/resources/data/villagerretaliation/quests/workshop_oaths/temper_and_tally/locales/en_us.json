    "quest.workshop_oaths.temper_and_tally.stage.finish_edge.dialogue.reminder.response.details.label": "Repeat the finish.",
    "quest.workshop_oaths.temper_and_tally.stage.finish_edge.dialogue.reminder.response.leave.label": "I will bring it.",
