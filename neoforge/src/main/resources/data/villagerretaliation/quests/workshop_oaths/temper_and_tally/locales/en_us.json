      "The tally waits. Metal is patient in ways people are not."
    ],
    "quest.workshop_oaths.temper_and_tally.stage.return.ui.tracker_text": "Return with the forge stock.",
    "quest.workshop_oaths.temper_and_tally.title": "Temper"
