    "quest.workshop_oaths.temper_and_tally.stage.finish_edge.scene.leave.lines": [
      "A rough edge is just unfinished honesty."
    ],
    "quest.workshop_oaths.temper_and_tally.stage.finish_edge.scene.reminder_details.action.remind.lines.reminder": [
      "Bring 1 grindstone to finish the workshop order."
