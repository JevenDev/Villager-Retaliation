          "tracker": {
            "text": "Place 16 logs as mine braces.",
            "complete_text": "The first braces are set.",
            "show_progress": true,
            "progress": 0.75
          }
        },
        {
          "id": "bring_lanterns",
          "type": "item_check",
          "item": "minecraft:lantern",
          "count": 4,
          "tracker": {
            "text": "Bring 4 lanterns for the braced shaft.",
            "complete_text": "The lanterns are ready.",
            "show_progress": true,
            "progress": 0.75
