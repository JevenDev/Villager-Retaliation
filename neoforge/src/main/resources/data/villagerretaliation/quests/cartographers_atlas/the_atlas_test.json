{
  "schema": "villagerretaliation:quest/v2",
  "id": "villagerretaliation:the_atlas_test",
  "metadata": {
    "title": "The Atlas Test",
    "description": "Choose a safer supply route or a riskier combat route to prove the atlas can guide real decisions.",
    "questline": "cartographers_atlas",
    "tags": [
      "group.exploration",
      "role.story",
      "activity.choice",
      "activity.combat",
      "activity.deliver",
      "activity.gather",
      "destination.overworld",
      "tier.mid",
      "difficulty.normal",
      "commitment.standard",
      "theme.exploration",
      "feature.encounter",
      "feature.scene",
      "party.challenge"
    ],
    "parent": "villagerretaliation:roads_that_remember",
    "title_key": "quest.cartographers_atlas.the_atlas_test.title",
    "description_key": "quest.cartographers_atlas.the_atlas_test.description"
  },
  "provider": {
    "type": "villagerretaliation:villager",
    "filters": {
      "min_villager_level": "expert",
      "professions": [
        "minecraft:cartographer"
      ],
      "skills": {
        "cartography": {
          "min": 34
        }
      }
    }
  },
  "availability": {
    "abandonment": "allow_repickup",
    "consume_on_completion": true,
    "cross_villager_compatible": true,
    "locked_to_villager": true,
    "max_completions": 1,
    "max_starts": 0,
    "repeatable": false
  },
  "entry_stage": "choose_test",
  "stages": [
    {
      "id": "choose_test",
      "objectives": [
        {
          "id": "choose_test_route",
          "type": "choice",
          "key": "test_route",
          "values": [
            "safe",
            "risky"
          ],
          "tracker": {
            "text": "Choose the atlas test route with the cartographer.",
            "complete_text": "You chose the {objective_choice_value} atlas test.",
            "show_progress": true,
            "progress": 0.35
          }
        }
      ],
      "complete_when": [
        "choose_test_route"
      ],
      "dialogue": {
        "offer": {
          "label": "The Atlas Test",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The atlas has pages, markers, and memory. Now it needs judgment.",
            "Choose the permanent test route: safe asks for four lanterns and eight bread; risky begins a three-pillager ambush and guarantees a crossbow proof item with the larger combat bonus."
          ],
          "responses": [
            {
              "id": "safe",
              "label": "Take the safer road",
              "text": "Good. A safer road is not a weaker test; it just asks whether the atlas can keep people fed and lit.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "test_route",
                  "value": "safe"
                },
                {
                  "type": "set_tag",
                  "scope": "player",
                  "tag": "villagerretaliation:atlas_test_safe"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose the safer atlas test. Bring the lanterns and bread for the road kit."
                }
              ],
              "transition": {
                "stage": "safe_supplies"
              }
            },
            {
              "id": "risky",
              "label": "Take the risky road",
              "text": "Risky road it is. Come back with proof the danger was real, not just imagined from a warm room.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "test_route",
                  "value": "risky"
                },
                {
                  "type": "set_tag",
                  "scope": "player",
                  "tag": "villagerretaliation:atlas_test_risky"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose the risky atlas test. Defeat the patrol and carry back a crossbow."
                },
                {
                  "type": "start_scene",
                  "scene": "villagerretaliation:atlas_risky_patrol",
                  "operation_id": "atlas_risky_patrol_v1",
                  "wait_for_result": true
                }
              ],
              "transition": {
                "stage": "risky_patrol"
              }
            },
            {
              "id": "decline",
              "label": "Another time",
              "scene": "decline"
            }
          ]
        },
        "reminder": {
          "label": "About The Atlas Test",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "This test choice is permanent. Safe is a supply hand-in; risky is an immediate three-pillager ambush with a guaranteed crossbow and larger bonus."
          ],
          "responses": [
            {
              "id": "details",
              "label": "Repeat the test",
              "scene": "reminder_details",
              "order": 0
            },
            {
              "id": "leave",
              "label": "I will choose",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "This choice is permanent: safe needs four lanterns and eight bread; risky launches three pillagers, guarantees the proof crossbow, and pays the larger bonus."
                ],
                "unavailable": [
                  "We are not carrying that test right now."
                ]
              }
            }
          ]
        },
        {
          "id": "decline",
          "lines": [
            "Then the atlas keeps studying instead of deciding."
          ]
        },
        {
          "id": "leave",
          "lines": [
            "A test is only useful if you choose it honestly."
          ]
        }
      ],
      "ui": {
        "tracker_text": "Choose the safer or riskier atlas test route.",
        "show_progress": true,
        "progress": 0.35
      }
    },
    {
      "id": "safe_supplies",
      "objectives": [
        {
          "id": "bring_lanterns",
          "type": "item_check",
          "item": "minecraft:lantern",
          "count": 4,
          "tracker": {
            "text": "Bring 4 lanterns to light a repeatable road.",
            "complete_text": "The lanterns are ready.",
            "show_progress": true,
            "progress": 0.65
          }
        },
        {
          "id": "bring_bread",
          "type": "item_check",
          "item": "minecraft:bread",
          "count": 8,
          "tracker": {
            "text": "Bring 8 bread for the safer road kit.",
            "complete_text": "The food kit is ready.",
            "show_progress": true,
            "progress": 0.75
          }
        }
      ],
      "complete_when": [
        "bring_lanterns",
        "bring_bread"
      ],
      "next": "safe_return",
      "dialogue": {
        "reminder": {
          "label": "About The Atlas Test",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "A safe road still needs proof. Bring lanterns and bread, the things a traveler notices only when they are missing."
          ],
          "responses": [
            {
              "id": "details",
              "label": "Repeat the kit",
              "scene": "reminder_details",
              "order": 0
            },
            {
              "id": "leave",
              "label": "Never mind",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "leave",
          "lines": [
            "The safer road still deserves respect."
          ]
        },
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "Bring 4 lanterns and 8 bread for the safer route test."
                ],
                "unavailable": [
                  "We are not carrying that test right now."
                ]
              }
            }
          ]
        }
      ],
      "ui": {
        "tracker_text": "Bring 4 lanterns and 8 bread for the safer route test.",
        "show_progress": true,
        "progress": 0.75
      }
    },
    {
      "id": "risky_patrol",
      "objectives": [
        {
          "id": "kill_pillagers",
          "type": "mob_kill",
          "entity": "minecraft:pillager",
          "count": 3,
          "tracker": {
            "text": "Defeat 3 pillagers to prove the riskier road can be defended.",
            "complete_text": "The risky road has been defended.",
            "show_progress": true,
            "progress": 0.65
          }
        },
        {
          "id": "bring_crossbow",
          "type": "item_check",
          "item": "minecraft:crossbow",
          "count": 1,
          "consume": false,
          "tracker": {
            "text": "Carry 1 crossbow as proof of the risky patrol.",
            "complete_text": "The patrol proof is ready.",
            "show_progress": true,
            "progress": 0.8
          }
        }
      ],
      "complete_when": [
        "kill_pillagers",
        "bring_crossbow"
      ],
      "next": "risky_return",
      "dialogue": {
        "reminder": {
          "label": "About The Atlas Test",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The riskier road needs proof that danger was not just guessed at from a safe table."
          ],
          "responses": [
            {
              "id": "details",
              "label": "Repeat the patrol",
              "scene": "reminder_details",
              "order": 0
            },
            {
              "id": "leave",
              "label": "Never mind",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "leave",
          "lines": [
            "Risk is not courage until someone returns with the account."
          ]
        },
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "Defeat 3 pillagers and carry a crossbow as proof of the riskier route test."
                ],
                "unavailable": [
                  "We are not carrying that test right now."
                ]
              }
            }
          ]
        }
      ],
      "ui": {
        "tracker_text": "Defeat 3 pillagers and carry a crossbow for the riskier route test.",
        "show_progress": true,
        "progress": 0.8
      }
    },
    {
      "id": "safe_return",
      "objectives": [],
      "dialogue": {
        "turn_in": {
          "label": "About The Atlas Test",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "A safe road with light and food. That is not glamorous, which is why it is useful."
          ],
          "responses": [
            {
              "id": "complete",
              "label": "Finish the safer test",
              "scene": "complete_safe"
            },
            {
              "id": "leave",
              "label": "Not yet",
              "scene": "leave"
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "complete_safe",
          "actions": [
            {
              "type": "loot",
              "loot_table": "villagerretaliation:quest/the_atlas_test_safe_bonus"
            },
            {
              "type": "quest",
              "action": "turn_in",
              "lines": {
                "completed": [
                  "The safer test is passed. The atlas now knows that mercy is also a route."
                ],
                "missing_objectives": [
                  "The safe road kit is still missing pieces."
                ],
                "unavailable": [
                  "I still need the safer road kit before we call this passed."
                ]
              }
            }
          ]
        },
        {
          "id": "leave",
          "lines": [
            "Bring the kit when the road is ready."
          ]
        }
      ],
      "ui": {
        "tracker_text": "Return to the cartographer with the safer road kit.",
        "show_progress": true,
        "progress": 1
      }
    },
    {
      "id": "risky_return",
      "objectives": [],
      "dialogue": {
        "turn_in": {
          "label": "About The Atlas Test",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "You chose the riskier road and came back with proof. That is the part an atlas cannot fake."
          ],
          "responses": [
            {
              "id": "complete",
              "label": "Finish the risky test",
              "scene": "complete_risky"
            },
            {
              "id": "leave",
              "label": "Not yet",
              "scene": "leave"
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "complete_risky",
          "actions": [
            {
              "type": "loot",
              "loot_table": "villagerretaliation:quest/the_atlas_test_risky_bonus"
            },
            {
              "type": "quest",
              "action": "turn_in",
              "lines": {
                "completed": [
                  "The riskier test is passed. The atlas now knows that danger can be measured without being worshiped."
                ],
                "missing_objectives": [
                  "The risky patrol still needs proof."
                ],
                "unavailable": [
                  "I still need the patrol proof before we call this passed."
                ]
              }
            }
          ]
        },
        {
          "id": "leave",
          "lines": [
            "Bring the proof when the road is ready."
          ]
        }
      ],
      "ui": {
        "tracker_text": "Return to the cartographer after the risky patrol.",
        "show_progress": true,
        "progress": 1
      }
    }
  ],
  "rewards": {
    "experience": 240,
    "gossip_reputation": 6,
    "loot_table": "villagerretaliation:quest/the_atlas_test",
    "memory_event": "player_completed_quest",
    "reputation": 15
  },
  "ui": {
    "title": "The Atlas Test",
    "title_key": "quest.cartographers_atlas.the_atlas_test.tracker.title"
  }
}
