{
  "schema": "villagerretaliation:quest/v2",
  "id": "villagerretaliation:ink_and_bearings",
  "metadata": {
    "title": "Ink and Bearings",
    "description": "Prepare the atlas index and choose whether its first principle favors roads or wonders.",
    "questline": "cartographers_atlas",
    "tags": [
      "group.exploration",
      "role.story",
      "activity.choice",
      "activity.deliver",
      "activity.gather",
      "destination.overworld",
      "tier.mid",
      "difficulty.normal",
      "commitment.standard",
      "theme.exploration",
      "feature.branching"
    ],
    "parent": "villagerretaliation:blank_map_promise",
    "title_key": "quest.cartographers_atlas.ink_and_bearings.title",
    "description_key": "quest.cartographers_atlas.ink_and_bearings.description"
  },
  "provider": {
    "type": "villagerretaliation:villager",
    "filters": {
      "min_villager_level": "apprentice",
      "professions": [
        "minecraft:cartographer"
      ],
      "skills": {
        "cartography": {
          "min": 10
        }
      }
    }
  },
  "availability": {
    "abandonment": "allow_repickup",
    "consume_on_completion": true,
    "cross_villager_compatible": false,
    "locked_to_villager": true,
    "max_completions": 1,
    "max_starts": 0,
    "repeatable": false
  },
  "entry_stage": "prepare_index",
  "stages": [
    {
      "id": "prepare_index",
      "objectives": [
        {
          "id": "bring_feathers",
          "type": "item_check",
          "item": "minecraft:feather",
          "count": 2,
          "tracker": {
            "text": "Bring 2 feathers for fine map pens.",
            "complete_text": "The map pens are ready.",
            "show_progress": true,
            "progress": 0.45
          }
        },
        {
          "id": "bring_glass",
          "type": "item_check",
          "item": "minecraft:glass_pane",
          "count": 6,
          "tracker": {
            "text": "Bring 6 glass panes to protect the index pages.",
            "complete_text": "The index panes are ready.",
            "show_progress": true,
            "progress": 0.55
          }
        }
      ],
      "complete_when": [
        "bring_feathers",
        "bring_glass"
      ],
      "next": "choose_principle",
      "dialogue": {
        "offer": {
          "label": "Ink and Bearings",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "A blank atlas can become a diary, a warning, or a trophy shelf. We should choose better than that.",
            "Bring fine pens and glass for the index. Then make a permanent atlas choice: roads prepare a compass-and-iron route kit, while wonders prepare a spyglass-and-amethyst survey kit for the first expedition."
          ],
          "responses": [
            {
              "id": "accept",
              "label": "Prepare the index",
              "scene": "start_quest"
            },
            {
              "id": "decline",
              "label": "Another time",
              "scene": "decline"
            }
          ]
        },
        "reminder": {
          "label": "About Ink and Bearings",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The atlas index still needs fine pens and panes before we choose its first rule."
          ],
          "responses": [
            {
              "id": "details",
              "label": "Repeat the list",
              "scene": "reminder_details",
              "order": 0
            },
            {
              "id": "abandon",
              "label": "Abandon quest",
              "scene": "abandon_confirm",
              "order": 90
            },
            {
              "id": "leave",
              "label": "Never mind",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "abandon_confirm",
          "lines": [
            "Set aside the atlas index for now?"
          ],
          "responses": [
            {
              "id": "confirm",
              "label": "Abandon quest",
              "scene": "abandon_quest"
            },
            {
              "id": "cancel",
              "label": "Keep the index",
              "scene": "leave"
            }
          ]
        },
        {
          "id": "abandon_quest",
          "actions": [
            {
              "type": "quest",
              "action": "abandon",
              "lines": {
                "abandoned": [
                  "I will keep the index loose until you return."
                ],
                "unavailable": [
                  "There is no atlas index open right now."
                ]
              }
            }
          ]
        },
        {
          "id": "decline",
          "lines": [
            "Then the atlas can wait before it starts having opinions."
          ]
        },
        {
          "id": "leave",
          "lines": [
            "A good bearing survives a pause."
          ]
        },
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "Bring 2 feathers and 6 glass panes. Once the index is ready, choose whether the atlas favors roads or wonders."
                ],
                "unavailable": [
                  "I do not have your atlas index open right now."
                ]
              }
            }
          ]
        },
        {
          "id": "start_quest",
          "actions": [
            {
              "type": "quest",
              "action": "start",
              "lines": {
                "already_completed": [
                  "The atlas already has its first principle."
                ],
                "started": [
                  "Bring 2 feathers and 6 glass panes. Good maps need clear ink and clearer intentions."
                ],
                "unavailable": [
                  "The first folio must be bound before the index matters."
                ]
              }
            }
          ]
        }
      ],
      "ui": {
        "tracker_text": "Bring 2 feathers and 6 glass panes for the atlas index.",
        "show_progress": true,
        "progress": 0.55
      }
    },
    {
      "id": "choose_principle",
      "objectives": [
        {
          "id": "choose_principle",
          "type": "choice",
          "key": "principle",
          "values": [
            "roads",
            "wonders"
          ],
          "tracker": {
            "text": "Choose the atlas principle with the cartographer.",
            "complete_text": "Atlas principle chosen: {objective_choice_value}.",
            "show_progress": true,
            "progress": 0.85
          }
        }
      ],
      "complete_when": [
        "choose_principle"
      ],
      "responses": [
        {
          "id": "roads",
          "label": "Favor reliable roads",
          "text": "Atlas principle chosen: roads.",
          "actions": [
            {
              "type": "set_variable",
              "scope": "quest",
              "key": "principle",
              "value": "roads"
            },
            {
              "type": "set_tag",
              "scope": "player",
              "tag": "villagerretaliation:atlas_principle_roads"
            },
            {
              "type": "notification",
              "trigger": "quest.updated",
              "text": "The atlas will favor reliable roads."
            }
          ],
          "transition": {
            "stage": "roads_ready"
          }
        },
        {
          "id": "wonders",
          "label": "Favor strange wonders",
          "text": "Atlas principle chosen: wonders.",
          "actions": [
            {
              "type": "set_variable",
              "scope": "quest",
              "key": "principle",
              "value": "wonders"
            },
            {
              "type": "set_tag",
              "scope": "player",
              "tag": "villagerretaliation:atlas_principle_wonders"
            },
            {
              "type": "notification",
              "trigger": "quest.updated",
              "text": "The atlas will favor strange wonders."
            }
          ],
          "transition": {
            "stage": "wonders_ready"
          }
        }
      ],
      "dialogue": {
        "reminder": {
          "label": "About Ink and Bearings",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The index is ready. This principle is permanent: roads reward practical navigation supplies on the first expedition; wonders reward rare survey tools."
          ],
          "responses": [
            {
              "id": "details",
              "label": "Repeat the choice",
              "scene": "reminder_details",
              "order": 0
            },
            {
              "id": "leave",
              "label": "I will choose",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "Choose roads for a compass-and-iron expedition kit, or wonders for a spyglass-and-amethyst kit. The principle is permanent."
                ],
                "unavailable": [
                  "We are not carrying that atlas principle right now."
                ]
              }
            }
          ]
        },
        {
          "id": "leave",
          "lines": [
            "Choose what you can live with following."
          ]
        }
      ],
      "ui": {
        "tracker_text": "Choose the atlas principle from the cartographer's branch options.",
        "show_progress": true,
        "progress": 0.85
      }
    },
    {
      "id": "roads_ready",
      "objectives": [],
      "dialogue": {
        "turn_in": {
          "label": "About Ink and Bearings",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "Roads, then. A map should first get people home."
          ],
          "responses": [
            {
              "id": "complete",
              "label": "Set the road principle",
              "scene": "complete_quest"
            },
            {
              "id": "leave",
              "label": "Not yet",
              "scene": "leave"
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "complete_quest",
          "actions": [
            {
              "type": "quest",
              "action": "turn_in",
              "lines": {
                "completed": [
                  "I have inked roads into the index. The atlas will look for ways back before it looks for glory."
                ],
                "missing_objectives": [
                  "Choose the atlas principle before I set the index."
                ],
                "unavailable": [
                  "The index still needs the proof we agreed on."
                ]
              }
            }
          ]
        },
        {
          "id": "leave",
          "lines": [
            "A good road waits at both ends."
          ]
        }
      ],
      "ui": {
        "tracker_text": "Return to the cartographer to set the road principle.",
        "show_progress": true,
        "progress": 1
      }
    },
    {
      "id": "wonders_ready",
      "objectives": [],
      "dialogue": {
        "turn_in": {
          "label": "About Ink and Bearings",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "Wonders, then. A map should leave room for the impossible."
          ],
          "responses": [
            {
              "id": "complete",
              "label": "Set the wonder principle",
              "scene": "complete_quest"
            },
            {
              "id": "leave",
              "label": "Not yet",
              "scene": "leave"
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "complete_quest",
          "actions": [
            {
              "type": "quest",
              "action": "turn_in",
              "lines": {
                "completed": [
                  "I have inked wonders into the index. The atlas will not mistake a hard road for an empty one."
                ],
                "missing_objectives": [
                  "Choose the atlas principle before I set the index."
                ],
                "unavailable": [
                  "The index still needs the proof we agreed on."
                ]
              }
            }
          ]
        },
        {
          "id": "leave",
          "lines": [
            "A wonder only looks impossible until someone writes it down."
          ]
        }
      ],
      "ui": {
        "tracker_text": "Return to the cartographer to set the wonder principle.",
        "show_progress": true,
        "progress": 1
      }
    }
  ],
  "rewards": {
    "experience": 115,
