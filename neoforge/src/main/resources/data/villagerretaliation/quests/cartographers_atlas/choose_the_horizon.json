{
  "schema": "villagerretaliation:quest/v2",
  "id": "villagerretaliation:choose_the_horizon",
  "metadata": {
    "title": "Choose the Horizon",
    "description": "Set the completed atlas toward the drowned coast or the dark roof road.",
    "questline": "cartographers_atlas",
    "tags": [
      "group.exploration"
    ],
    "parent": "villagerretaliation:the_atlas_test",
    "title_key": "quest.cartographers_atlas.choose_the_horizon.title",
    "description_key": "quest.cartographers_atlas.choose_the_horizon.description"
  },
  "provider": {
    "type": "villagerretaliation:villager",
    "filters": {
      "min_villager_level": "master",
      "professions": [
        "minecraft:cartographer"
      ],
      "skills": {
        "cartography": {
          "min": 48
        }
      }
    }
  },
  "availability": {
    "abandonment": "allow_repickup",
    "consume_on_completion": true,
    "cross_villager_compatible": false,
    "locked_to_villager": true,
    "max_completions": 1,
    "max_starts": 0,
    "repeatable": false
  },
  "events": [
    {
      "id": "horizon_chosen",
      "event": "completed",
      "repeatable": false,
      "actions": [
        {
          "type": "set_tag",
          "scope": "player",
          "tag": "villagerretaliation:cartographers_atlas_horizon_chosen"
        }
      ]
    }
  ],
  "entry_stage": "started",
  "stages": [
    {
      "id": "started",
      "objectives": [
        {
          "id": "choose_route",
          "type": "choice",
          "key": "choice",
          "values": [
            "coast",
            "dark_roof"
          ],
          "tracker": {
            "text": "Choose the final atlas horizon with the cartographer.",
            "complete_text": "You chose the {objective_choice_value} horizon.",
            "show_progress": true,
            "progress": 0.45
          }
        }
      ],
      "complete_when": [
        "choose_route"
      ],
      "dialogue": {
        "offer": {
          "label": "Choose the Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The atlas has paper, bearings, field proof, memory, and judgment. Now it asks for a horizon.",
            "Choose the drowned coast if you want the atlas to follow water and ruins. Choose the dark roof road if you want it to follow danger under old timber."
          ],
          "responses": [
            {
              "id": "coast",
              "label": "Choose the drowned coast",
              "text": "Then we choose the coast. Keep your eyes on drowned stone, and do not trust quiet water.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "coast"
                },
                {
                  "type": "set_tag",
                  "scope": "player",
                  "tag": "villagerretaliation:atlas_coast_route"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose the drowned coast. Reach the Ocean Monument, then bring back the prismarine proof."
                }
              ],
              "transition": {
                "stage": "coast_final"
              }
            },
            {
              "id": "dark_roof",
              "label": "Choose the dark roof road",
              "text": "Then we choose the dark roof road. If the house looks back, look back harder.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "dark_roof"
                },
                {
                  "type": "set_tag",
                  "scope": "player",
                  "tag": "villagerretaliation:atlas_dark_roof_route"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose the dark roof road. Reach the Woodland Mansion, then bring back the binding proof."
                }
              ],
              "transition": {
                "stage": "dark_roof_final"
              }
            },
            {
              "id": "decline",
              "label": "Another time",
              "scene": "decline"
            }
          ]
        },
        "reminder": {
          "label": "About the Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "This is the final fork. Coast or dark roof; water-stone or old timber."
          ],
          "responses": [
            {
              "id": "details",
              "label": "Repeat the fork",
              "scene": "reminder_details",
              "order": 0
            },
            {
              "id": "leave",
              "label": "I will choose",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "Choose the drowned coast for water, prismarine, and ocean ruins. Choose the dark roof road for books, illagers, and a mansion horizon."
                ],
                "unavailable": [
                  "I do not have your horizon page open right now."
                ]
              }
            }
          ]
        },
        {
          "id": "decline",
          "lines": [
            "Then the horizon stays unchosen, which is a kind of answer but not a useful one."
          ]
        },
        {
          "id": "leave",
          "lines": [
            "Choose with both eyes open."
          ]
        }
      ],
      "ui": {
        "tracker_text": "Choose the final atlas horizon from the cartographer's branch options.",
        "show_progress": true,
        "progress": 0.45
      }
    },
    {
      "id": "coast_final",
      "objectives": [
        {
          "id": "visit_monument",
          "type": "structure_visit",
          "structure": "minecraft:monument",
          "search_radius": 384,
          "discovery_radius": 160,
          "tracker": {
            "text": "Reach the Ocean Monument near {target_x}, {target_z}.",
            "complete_text": "The drowned coast mark is confirmed.",
            "show_progress": true,
            "progress": 0.65
          }
        },
        {
          "id": "bring_prismarine_crystals",
          "type": "item_check",
          "item": "minecraft:prismarine_crystals",
          "count": 4,
          "tracker": {
            "text": "Bring 4 prismarine crystals to bind the drowned coast horizon.",
            "complete_text": "The coast binding crystals are ready.",
            "show_progress": true,
            "progress": 0.8
          }
        },
        {
          "id": "bring_prismarine_shards",
          "type": "item_check",
          "item": "minecraft:prismarine_shard",
          "count": 4,
          "tracker": {
            "text": "Bring 4 prismarine shards to set the coast margin.",
            "complete_text": "The coast margin shards are ready.",
            "show_progress": true,
            "progress": 0.85
          }
        }
      ],
      "complete_when": [
        "visit_monument",
        "bring_prismarine_crystals",
        "bring_prismarine_shards"
      ],
      "next": "coast_chosen",
      "dialogue": {
        "reminder": {
          "label": "About the Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The drowned coast needs prismarine proof before I can set it into the final folio."
          ],
          "responses": [
            {
              "id": "details",
              "label": "Repeat the proof",
              "scene": "reminder_details",
              "order": 0
            },
            {
              "id": "leave",
              "label": "Never mind",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "leave",
          "lines": [
            "The tide can wait, but it will not wait forever."
          ]
        },
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "Reach the Ocean Monument near the mark, then bring 4 prismarine crystals and 4 prismarine shards to bind the drowned coast horizon."
                ],
                "unavailable": [
                  "I do not have your horizon page open right now."
                ]
              }
            }
          ]
        }
      ],
      "ui": {
        "tracker_text": "Reach the Ocean Monument, then bring prismarine crystals and shards.",
        "show_progress": true,
        "progress": 0.85
      }
    },
    {
      "id": "dark_roof_final",
      "objectives": [
        {
          "id": "visit_mansion",
          "type": "structure_visit",
          "structure": "minecraft:woodland_mansion",
          "search_radius": 768,
          "discovery_radius": 192,
          "tracker": {
            "text": "Reach the Woodland Mansion near {target_x}, {target_z}.",
            "complete_text": "The dark roof mark is confirmed.",
            "show_progress": true,
            "progress": 0.65
          }
        },
        {
          "id": "bring_books",
          "type": "item_check",
          "item": "minecraft:book",
          "count": 6,
          "tracker": {
            "text": "Bring 6 books for the dark roof index.",
            "complete_text": "The dark roof index is ready.",
            "show_progress": true,
            "progress": 0.75
          }
        },
        {
          "id": "carry_totem",
          "type": "item_check",
          "item": "minecraft:totem_of_undying",
          "count": 1,
          "consume": false,
          "tracker": {
            "text": "Carry a Totem of Undying as proof the dark roof road was not imaginary.",
            "complete_text": "The dark roof proof is ready.",
            "show_progress": true,
            "progress": 0.9
          }
        }
      ],
      "complete_when": [
        "visit_mansion",
        "bring_books",
        "carry_totem"
      ],
      "next": "dark_roof_chosen",
      "dialogue": {
        "reminder": {
          "label": "About the Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The dark roof road needs books and a totem before I can set it into the final folio."
          ],
          "responses": [
            {
              "id": "details",
              "label": "Repeat the proof",
              "scene": "reminder_details",
              "order": 0
            },
            {
              "id": "leave",
              "label": "Never mind",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "leave",
          "lines": [
            "The roof will stay dark without our help."
          ]
        },
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "Reach the Woodland Mansion near the mark, then bring 6 books and carry a Totem of Undying to bind the dark roof road."
                ],
                "unavailable": [
                  "I do not have your horizon page open right now."
                ]
              }
            }
          ]
        }
      ],
      "ui": {
        "tracker_text": "Reach the Woodland Mansion, then bring books and a totem.",
        "show_progress": true,
        "progress": 0.9
      }
    },
    {
      "id": "coast_chosen",
      "objectives": [],
      "dialogue": {
        "turn_in": {
          "label": "About the Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The drowned coast proof is here. The atlas can finally point beyond its own margin."
          ],
          "responses": [
            {
              "id": "complete",
              "label": "Set the drowned coast horizon",
              "scene": "complete_coast"
            },
            {
              "id": "leave",
              "label": "Not yet",
              "scene": "leave"
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "complete_coast",
