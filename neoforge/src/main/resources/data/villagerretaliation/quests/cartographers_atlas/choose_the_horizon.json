      ],
      "complete_when": [
        "carry_spyglass",
        "carry_boat",
        "bring_provisions"
      ],
      "next": "coast_chosen",
      "dialogue": {
        "reminder": {
          "label": "About the Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "Before the drowned-coast page opens, assemble a spyglass, a boat, and enough provisions for the monument survey."
          ],
          "responses": [
            {
              "id": "details",
              "label": "Repeat the kit",
              "scene": "reminder_details",
              "order": 0
            },
            {
              "id": "leave",
              "label": "Never mind",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "leave",
          "lines": [
            "The tide can wait, but it will not wait forever."
          ]
        },
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "Carry 1 spyglass and 1 oak boat, then bring 16 cooked cod for the drowned-coast expedition."
