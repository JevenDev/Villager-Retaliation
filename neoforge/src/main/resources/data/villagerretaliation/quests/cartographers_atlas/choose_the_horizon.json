{
  "schema": "villagerretaliation:quest/v2",
  "id": "villagerretaliation:choose_the_horizon",
  "metadata": {
    "title": "Choose The Horizon",
    "description": "Choose whether the atlas follows the coast or the dark roof road.",
    "questline": "cartographers_atlas",
    "tags": [
      "group.exploration"
    ],
    "parent": "villagerretaliation:first_far_marker"
  },
  "provider": {
    "type": "villagerretaliation:villager",
    "filters": {
      "min_villager_level": "apprentice",
      "professions": [
        "minecraft:cartographer"
      ],
      "skills": {
        "cartography": {
          "min": 20
        }
      }
    }
  },
  "availability": {
    "abandonment": "allow_repickup",
    "consume_on_completion": false,
    "cross_villager_compatible": false,
    "locked_to_villager": true,
    "max_completions": 1,
    "max_starts": 0,
    "repeatable": false
  },
  "entry_stage": "started",
  "stages": [
    {
      "id": "started",
      "objectives": [
        {
          "id": "choose_route",
          "type": "choice",
          "key": "choice",
          "values": [
            "coast",
            "dark_roof"
          ],
          "tracker": {
            "text": "Choose the next atlas route with the cartographer.",
            "complete_text": "Route chosen: {objective_choice_value}.",
            "show_progress": true,
            "progress": 0.9
          }
        }
      ],
      "complete_when": [
        "choose_route"
      ],
      "responses": [
        {
          "id": "coast",
          "label": "Chart the drowned coast",
          "text": "Atlas route chosen: drowned coast.",
          "actions": [
            {
              "type": "set_variable",
              "scope": "quest",
              "key": "choice",
              "value": "coast"
            },
            {
              "type": "set_tag",
              "scope": "player",
              "tag": "villagerretaliation:atlas_coast_route"
            },
            {
              "type": "notification",
              "trigger": "quest.updated",
              "text": "Atlas route chosen: drowned coast."
            }
          ],
          "transition": {
            "stage": "coast_chosen"
          }
        },
        {
          "id": "dark_roof",
          "label": "Chart the dark roof road",
          "text": "Atlas route chosen: dark roof road.",
          "actions": [
            {
              "type": "set_variable",
              "scope": "quest",
              "key": "choice",
              "value": "dark_roof"
            },
            {
              "type": "set_tag",
              "scope": "player",
              "tag": "villagerretaliation:atlas_dark_roof_route"
            },
            {
              "type": "notification",
              "trigger": "quest.updated",
              "text": "Atlas route chosen: dark roof road."
            }
          ],
          "transition": {
            "stage": "dark_roof_chosen"
          }
        }
      ],
      "dialogue": {
        "offer": {
          "label": "Choose The Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The atlas forks. One route follows drowned stone under the sea. The other follows a roof so dark birds avoid it."
          ],
          "responses": [
            {
              "id": "accept",
              "label": "Open the atlas",
              "scene": "start_quest"
            },
            {
              "id": "decline",
              "label": "Another time",
              "scene": "decline"
            }
          ]
        },
        "reminder": {
          "label": "About The Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "Pick the coast if you want guardians and prismarine. Pick the dark roof if you want illagers and stolen books. The branch options should be in my notes."
          ],
          "responses": [
            {
              "id": "remind",
              "label": "Repeat the branch",
              "scene": "reminder_details",
              "order": 80
            },
            {
              "id": "abandon",
              "label": "Abandon quest",
              "scene": "abandon_confirm",
              "order": 90
            },
            {
              "id": "leave",
              "label": "I will choose",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "abandon_confirm",
          "lines": [
            "Close the branch page for now?"
          ],
          "responses": [
            {
              "id": "confirm",
              "label": "Abandon quest",
              "scene": "abandon_quest"
            },
            {
              "id": "cancel",
              "label": "Keep the quest",
              "scene": "leave"
            }
          ]
        },
        {
          "id": "abandon_quest",
          "actions": [
            {
              "type": "quest",
              "action": "abandon",
              "lines": {
                "abandoned": [
                  "I will close the fork for now. It can reopen if you still want the atlas."
                ],
                "unavailable": [
                  "There is no branch page to close."
                ]
              }
            }
          ]
        },
        {
          "id": "decline",
          "lines": [
            "Then the horizon keeps both secrets."
          ]
        },
        {
          "id": "leave",
          "lines": [
            "Choose with both eyes open."
          ]
        },
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "Choose the drowned coast for ocean ruins, or the dark roof road for woodland mansions. The atlas will follow one branch."
                ],
                "unavailable": [
                  "The branch page is not active right now."
                ]
              }
            }
          ]
        },
        {
          "id": "start_quest",
          "actions": [
            {
              "type": "quest",
              "action": "start",
              "lines": {
                "started": [
                  "The branch page is open. Choose the drowned coast or the dark roof road from my notes."
                ],
                "unavailable": [
                  "The atlas cannot fork yet."
                ]
              }
            }
          ]
        }
      ],
      "ui": {
        "tracker_text": "Pick the atlas route from the cartographer's branch options.",
        "show_progress": true,
        "progress": 0.7
      }
    },
    {
      "id": "coast_chosen",
      "objectives": [],
      "dialogue": {
        "turn_in": {
          "label": "About The Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The route is chosen. Let me fix the ink before it changes its mind."
          ],
          "responses": [
            {
              "id": "complete",
              "label": "Set the route",
              "scene": "complete_quest"
            },
            {
              "id": "leave",
              "label": "Not yet",
              "scene": "leave"
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "complete_quest",
          "actions": [
            {
              "type": "quest",
              "action": "turn_in",
              "lines": {
                "completed": [
                  "Done. The atlas will follow the road you chose."
                ],
                "missing_objectives": [
                  "Choose a route from the branch notes before I set the ink."
                ],
                "missing_proof": [
                  "Choose a route first."
                ],
                "unavailable": [
                  "The branch page is not ready to close."
                ]
              }
            }
          ]
        },
        {
          "id": "leave",
          "lines": [
            "Choose with both eyes open."
          ]
        }
      ],
      "ui": {
        "tracker_text": "Return to the cartographer after choosing the route.",
        "show_progress": true,
        "progress": 1
      }
    },
    {
      "id": "dark_roof_chosen",
      "objectives": [],
      "dialogue": {
        "turn_in": {
          "label": "About The Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The route is chosen. Let me fix the ink before it changes its mind."
          ],
          "responses": [
            {
              "id": "complete",
              "label": "Set the route",
              "scene": "complete_quest"
            },
            {
              "id": "leave",
              "label": "Not yet",
              "scene": "leave"
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "complete_quest",
          "actions": [
            {
              "type": "quest",
              "action": "turn_in",
              "lines": {
                "completed": [
                  "Done. The atlas will follow the road you chose."
                ],
                "missing_objectives": [
                  "Choose a route from the branch notes before I set the ink."
                ],
                "missing_proof": [
                  "Choose a route first."
                ],
                "unavailable": [
                  "The branch page is not ready to close."
                ]
              }
            }
          ]
        },
        {
          "id": "leave",
          "lines": [
            "Choose with both eyes open."
          ]
        }
      ],
      "ui": {
        "tracker_text": "Return to the cartographer after choosing the route.",
        "show_progress": true,
        "progress": 1
      }
    }
  ],
  "rewards": {
    "experience": 80,
    "gossip_reputation": 2,
    "loot_table": "villagerretaliation:quest/choose_the_horizon",
    "memory_event": "player_completed_quest",
