{
  "schema": "villagerretaliation:quest/v2",
  "id": "villagerretaliation:choose_the_horizon",
  "metadata": {
    "title": "Choose the Horizon",
    "description": "Choose and prepare the atlas's first great Overworld route.",
    "questline": "cartographers_atlas",
    "tags": [
      "group.exploration",
      "role.story",
      "activity.choice",
      "activity.deliver",
      "activity.gather",
      "destination.overworld",
      "tier.late",
      "difficulty.normal",
      "commitment.standard",
      "theme.exploration",
      "feature.branching",
      "feature.scene"
    ],
    "parent": "villagerretaliation:the_atlas_test",
    "title_key": "quest.cartographers_atlas.choose_the_horizon.title",
    "description_key": "quest.cartographers_atlas.choose_the_horizon.description"
  },
  "provider": {
    "type": "villagerretaliation:villager",
    "filters": {
      "min_villager_level": "master",
      "professions": [
        "minecraft:cartographer"
      ],
      "skills": {
        "cartography": {
          "min": 48
        }
      }
    }
  },
  "availability": {
    "abandonment": "allow_repickup",
    "consume_on_completion": true,
    "cross_villager_compatible": false,
    "locked_to_villager": true,
    "max_completions": 1,
    "max_starts": 0,
    "repeatable": false
  },
  "events": [
    {
      "id": "horizon_chosen",
      "event": "completed",
      "repeatable": false,
      "actions": [
        {
          "type": "set_tag",
          "scope": "player",
          "tag": "villagerretaliation:cartographers_atlas_horizon_chosen"
        }
      ]
    }
  ],
  "entry_stage": "started",
  "stages": [
    {
      "id": "started",
      "objectives": [
        {
          "id": "choose_route",
          "type": "choice",
          "key": "choice",
          "values": [
            "coast",
            "dark_roof"
          ],
          "tracker": {
            "text": "Choose the atlas's Overworld horizon with the cartographer.",
            "complete_text": "You chose the {objective_choice_value} horizon.",
            "show_progress": true,
            "progress": 0.45
          }
        }
      ],
      "complete_when": [
        "choose_route"
      ],
      "dialogue": {
        "offer": {
          "label": "Choose the Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "The atlas has paper, bearings, field proof, memory, and judgment. Now it asks for its first great horizon.",
            "This permanent choice closes the other Overworld route. The coast kit prepares for a monument survey; the dark roof kit prepares for a mansion survey."
          ],
          "responses": [
            {
              "id": "coast",
              "label": "Choose the drowned coast",
              "text": "Then we choose the coast. Keep your eyes on drowned stone, and do not trust quiet water.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "coast"
                },
                {
                  "type": "set_tag",
                  "scope": "player",
                  "tag": "villagerretaliation:atlas_coast_route"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose the drowned coast. Assemble a spyglass, boat, and provisions before the monument survey."
                },
                {
                  "type": "start_scene",
                  "scene": "villagerretaliation:atlas_horizon_choice",
                  "operation_id": "atlas_horizon_choice_v1",
                  "wait_for_result": true
                }
              ],
              "transition": {
                "stage": "coast_final"
              }
            },
            {
              "id": "dark_roof",
              "label": "Choose the dark roof road",
              "text": "Then we choose the dark roof road. If the house looks back, look back harder.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "dark_roof"
                },
                {
                  "type": "set_tag",
                  "scope": "player",
                  "tag": "villagerretaliation:atlas_dark_roof_route"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose the dark roof road. Assemble a shield, crossbow, and torches before the mansion survey."
                },
                {
                  "type": "start_scene",
                  "scene": "villagerretaliation:atlas_horizon_choice",
                  "operation_id": "atlas_horizon_choice_v1",
                  "wait_for_result": true
                }
              ],
              "transition": {
                "stage": "dark_roof_final"
              }
            },
            {
              "id": "decline",
              "label": "Another time",
              "scene": "decline"
            }
          ]
        },
        "reminder": {
          "label": "About the Horizon",
          "request": "question",
          "order": -24,
          "show_for_babies": false,
          "lines": [
            "This permanent Overworld fork closes the other route: coast prepares for a monument survey; dark roof prepares for a mansion survey."
          ],
          "responses": [
            {
              "id": "details",
              "label": "Repeat the fork",
              "scene": "reminder_details",
              "order": 0
            },
            {
              "id": "leave",
              "label": "I will choose",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "This choice closes the other Overworld horizon. Coast needs a spyglass, boat, and provisions; dark roof needs a shield, crossbow, and torches."
                ],
                "unavailable": [
                  "I do not have your horizon page open right now."
                ]
              }
            }
          ]
        },
        {
          "id": "decline",
          "lines": [
            "Then the horizon stays unchosen, which is a kind of answer but not a useful one."
          ]
        },
        {
          "id": "leave",
          "lines": [
            "Choose with both eyes open."
          ]
        }
      ],
      "ui": {
        "tracker_text": "Choose the atlas's Overworld horizon from the cartographer's branch options.",
        "show_progress": true,
        "progress": 0.45
      }
    },
    {
      "id": "coast_final",
      "objectives": [
        {
          "id": "carry_spyglass",
          "type": "item_check",
          "item": "minecraft:spyglass",
          "count": 1,
          "consume": false,
          "tracker": {
            "text": "Carry 1 spyglass for the drowned-coast survey.",
            "complete_text": "The survey spyglass is ready.",
            "show_progress": true,
            "progress": 0.65
          }
        },
