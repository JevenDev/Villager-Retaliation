            },
            {
              "id": "leave",
              "label": "Never mind",
              "scene": "leave",
              "order": 100
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "leave",
          "lines": [
            "The roof will stay dark without our help."
          ]
        },
        {
          "id": "reminder_details",
          "actions": [
            {
              "type": "quest",
              "action": "remind",
              "lines": {
                "reminder": [
                  "Carry 1 shield and 1 crossbow, then bring 32 torches for the dark-roof expedition."
