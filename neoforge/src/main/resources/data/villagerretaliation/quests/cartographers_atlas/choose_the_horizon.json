          "count": 1,
          "consume": false,
          "tracker": {
            "text": "Carry 1 oak boat for the drowned-coast route.",
            "complete_text": "The coast boat is ready.",
            "show_progress": true,
            "progress": 0.75
          }
        },
        {
          "id": "bring_provisions",
          "type": "item_check",
          "item": "minecraft:cooked_cod",
          "count": 16,
          "tracker": {
            "text": "Bring 16 cooked cod for the coast expedition.",
            "complete_text": "The coast provisions are packed.",
            "show_progress": true,
            "progress": 0.9
