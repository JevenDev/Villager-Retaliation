      "dialogue": {
        "offer": {
          "label": "Choose a Road",
          "request": "question",
          "order": -22,
          "show_for_babies": false,
          "lines": [
            "The Nether road can follow fortress bridges or bastion walls. One is full of fire; the other is full of owners.",
            "A fortress offers brewing supplies. A bastion offers gold and better stonework. Neither offers kindness."
          ],
          "responses": [
            {
              "id": "fortress",
              "label": "Follow the fortress",
              "text": "Fortress road. Mark every bridge and never stand where a blaze can see both sides of you.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "fortress"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose the Nether Fortress road."
                }
              ],
              "transition": {
                "stage": "fortress_work"
              }
            },
            {
              "id": "bastion",
              "label": "Follow the bastion",
              "text": "Bastion road. Wear gold, watch the brutes, and do not admire anything with your hands.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "bastion"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose the Bastion Remnant road."
                }
