{
  "actors": [
    {
      "alias": "player",
      "binding_source": "owner_player",
      "capabilities": [
        "villagerretaliation:capability/live_entity"
      ],
      "death_policy": "block",
      "missing_actor_policy": "wait_until_timeout",
      "replacement_policy": "fixed",
      "required": true,
      "timeout_ticks": 1200,
      "type": "villagerretaliation:player"
    },
    {
      "alias": "route_keeper",
      "binding_source": "quest_provider",
      "capabilities": [
        "villagerretaliation:capability/dialogue"
      ],
      "death_policy": "continue_with_snapshot",
      "missing_actor_policy": "skip",
      "replacement_policy": "compatible_replacement",
      "required": false,
      "timeout_ticks": 1200,
      "type": "villagerretaliation:villager"
    }
  ],
  "cancellation_policy": "cancel_scene",
  "cleanup_policy": "all_owned",
  "definition_version": 2,
  "entry_step": "route_warning",
  "failure_policy": "block_for_repair",
  "id": "villagerretaliation:night_run_attack",
  "metadata": {
    "quest": "villagerretaliation:night_run",
    "title": {
      "key": "#scene.night_run_attack.metadata.title"
    }
  },
  "ownership": "quest_instance",
  "schema": "villagerretaliation:scene/v1",
  "steps": [
    {
      "actors": [
        "route_keeper"
      ],
      "data": {
        "offline_policy": "wait",
        "offline_poll_ticks": 20,
        "text": {
          "key": "#scene.night_run_attack.step.route_warning.data.text"
        }
      },
      "failure_step": "failed",
      "id": "route_warning",
      "next": "listen_in_dark",
      "type": "villagerretaliation:dialogue"
    },
    {
      "data": {
        "ticks": 40
      },
      "id": "listen_in_dark",
      "next": "start_attack",
      "type": "villagerretaliation:wait_ticks"
    },
    {
      "data": {
        "anchor_actor": "route_keeper",
        "difficulty": "normal",
        "offset_x": 20,
        "offset_z": 12,
        "surface_anchor": true,
        "template": "villagerretaliation:night_run_attack"
      },
      "failure_step": "failed",
      "id": "start_attack",
      "next": "clear_route",
      "type": "villagerretaliation:start_encounter"
    },
    {
      "data": {
        "encounter_step": "start_attack"
      },
      "failure_step": "failed",
      "id": "clear_route",
      "next": "clean_up",
      "type": "villagerretaliation:wait_encounter"
    },
    {
      "data": {
        "encounter_step": "start_attack",
        "force_remove": false
      },
      "failure_step": "failed",
      "id": "clean_up",
      "next": "mark_the_road",
      "type": "villagerretaliation:cleanup_encounter"
    },
    {
      "actors": [
        "route_keeper"
      ],
      "data": {
        "text": {
          "key": "#scene.night_run_attack.step.mark_the_road.data.text"
        }
      },
      "failure_step": "failed",
      "id": "mark_the_road",
      "next": "completed",
      "type": "villagerretaliation:dialogue"
    },
    {
      "id": "completed",
      "type": "villagerretaliation:scene_complete"
    },
    {
      "id": "failed",
      "type": "villagerretaliation:scene_fail"
    }
  ],
  "timeout_ticks": 3600
}
