          "request": "question",
          "order": -22,
          "show_for_babies": false,
          "lines": [
            "Zombies do not wait for clean rooms. Thin them out and bring the samples."
          ],
          "responses": [
            {
              "id": "details",
              "label": "Repeat the ward work.",
              "scene": "reminder_details"
            },
            {
              "id": "leave",
              "label": "I will handle it.",
              "scene": "leave"
            }
          ]
