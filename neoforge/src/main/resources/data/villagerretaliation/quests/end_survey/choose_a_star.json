    "tags": [
      "group.end_survey",
      "branching"
    ]
  },
  "provider": {
    "type": "villagerretaliation:villager",
    "filters": {
      "professions": [
        "minecraft:cartographer",
        "minecraft:librarian"
      ],
      "min_villager_level": "master",
      "skills": {
        "cartography": {
          "min": 50
        },
        "scholarship": {
          "min": 44
        }
      }
    }
  },
  "availability": {
