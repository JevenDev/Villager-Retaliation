    "locked_to_villager": true,
    "cross_villager_compatible": false
  },
  "entry_stage": "choose",
  "stages": [
    {
      "id": "choose",
      "objectives": [
        {
          "id": "choose_route",
          "type": "choice",
          "key": "choice",
          "values": [
            "chorus",
            "city"
          ],
          "tracker": {
            "text": "Choose the route with the quest giver.",
            "complete_text": "Route chosen: {objective_choice_value}.",
            "show_progress": true,
            "progress": 0.2
          }
        }
      ],
      "complete_when": [
        "choose_route"
      ],
      "dialogue": {
        "offer": {
          "label": "Choose a Star",
          "request": "question",
          "order": -22,
          "show_for_babies": false,
          "lines": [
            "The outer islands offer two lights: chorus groves close to the ground, or End rods high in a city.",
            "Follow the chorus and map how the islands grow, or follow the city lights and map who built above them."
          ],
          "responses": [
            {
              "id": "chorus",
              "label": "Follow the chorus",
              "text": "Chorus trail. Keep your feet ready for the fruit to change its mind about where you belong.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "chorus"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose the chorus trail through the outer End."
                }
              ],
              "transition": {
                "stage": "chorus_work"
              }
            },
            {
              "id": "city",
              "label": "Follow the city lights",
              "text": "City light. Watch the towers, the void between them, and every shell pretending to be a block.",
              "actions": [
                {
                  "type": "set_variable",
                  "scope": "quest",
                  "key": "choice",
                  "value": "city"
                },
                {
                  "type": "notification",
                  "trigger": "quest.updated",
                  "text": "You chose the End City lights."
                }
              ],
              "transition": {
                "stage": "city_work"
              }
            },
            {
              "id": "decline",
              "label": "Not yet.",
              "scene": "decline"
            }
          ]
