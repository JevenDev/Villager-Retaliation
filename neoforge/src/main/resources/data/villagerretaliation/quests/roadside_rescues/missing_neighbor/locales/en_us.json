{
  "schema": "villagerretaliation:quest_locale/v1",
  "messages": {
    "villagerretaliation.quest.missing_neighbor.start.preparing": {
      "lines": ["Give me a moment to check that lead. Stay nearby and I will mark your map when it is ready."]
    },
    "villagerretaliation.quest.missing_neighbor.title": {
      "lines": [
        "A Missing Neighbor"
      ]
    },
    "villagerretaliation.quest.missing_neighbor.description": {
      "lines": [
        "Find the pillager holding site, free the captive, and escort them home."
      ]
    },
    "villagerretaliation.quest.missing_neighbor.rescue.tracker": {
      "lines": [
        "Find the holding site, reach the captive through the guards or another entrance, and escort them home."
      ]
    },
    "villagerretaliation.quest.missing_neighbor.offer.label": {
      "lines": [
        "A Missing Neighbor"
      ]
    },
    "villagerretaliation.quest.missing_neighbor.offer.lines": {
      "lines": [
        "A neighbor has been taken by pillagers. I can mark the search area if you can bring them home."
      ]
    },
    "villagerretaliation.quest.missing_neighbor.offer.accept": {
      "lines": [
        "I'll bring them home."
      ]
    },
    "villagerretaliation.quest.missing_neighbor.reminder.label": {
      "lines": [
        "About our missing neighbor"
      ]
    },
    "villagerretaliation.quest.missing_neighbor.reminder.lines": {
      "lines": [
        "Search the area on your map. Find a way to reach our neighbor, speak to them, and lead them back here."
      ]
    },
    "villagerretaliation.quest.missing_neighbor.route.label": {
      "lines": [
        "Rear entrance"
      ]
    },
    "villagerretaliation.quest.missing_neighbor.route.question": {
      "lines": [
        "Is there another way inside?"
      ]
    },
    "villagerretaliation.quest.missing_neighbor.route.answer": {
      "lines": [
        "Look around the south side of the holding area. There is an opening behind the captive, away from the guards at the front. Reach that entrance, then get our neighbor out. The guards can still spot you, so take care."
      ]
    },
    "villagerretaliation.quest.missing_neighbor.reminder.response": {
      "lines": [
        "I'll keep looking."
      ]
    },
    "villagerretaliation.quest.missing_neighbor.start.started": {
      "lines": [
        "The search area is marked on your map. Please bring our neighbor home."
      ]
    },
    "villagerretaliation.quest.missing_neighbor.start.failed": {
      "lines": [
        "I cannot find a safe lead right now."
      ]
    },
    "villagerretaliation.quest.missing_neighbor.return.label": {
      "lines": [
        "Our neighbor is home"
      ]
    },
    "villagerretaliation.quest.missing_neighbor.return.lines": {
      "lines": [
        "You brought them back safely. We won't forget what you did."
      ]
    },
    "villagerretaliation.quest.missing_neighbor.return.response": {
      "lines": [
        "They're safe now."
      ]
    },
    "villagerretaliation.quest.missing_neighbor.return.completed": {
      "lines": [
        "Thank you for bringing our neighbor home."
      ]
    }
  }
}
