              "Good. Bring 24 paper, 1 compass, and 3 ink sacs. Small supplies, long road."
            ],
            "already_completed": [
              "The atlas already has its first folio."
            ],
            "unavailable": [
              "The map table is not ready to start that with you yet."
            ]
          }
        }
      ],
      "end": true
    },
    "active_menu": {
      "lines": [
        "The atlas folio is still waiting. I can repeat the list or set the note aside."
