{
  "schema": "villagerretaliation:scene/v1",
  "id": "villagerretaliation:nether_road_choice",
  "definition_version": 1,
  "metadata": {
    "title": "Nether road choice",
    "quest": "villagerretaliation:choose_a_road"
  },
  "ownership": "quest_instance",
  "entry_step": "unroll_the_route",
  "timeout_ticks": 1200,
  "failure_policy": "block_for_repair",
  "cancellation_policy": "cancel_scene",
  "cleanup_policy": "none",
  "actors": [
    {
      "alias": "player",
      "type": "villagerretaliation:player",
      "required": true,
      "capabilities": [
        "villagerretaliation:capability/live_entity"
      ],
      "binding_source": "owner_player",
      "replacement_policy": "fixed",
      "missing_actor_policy": "wait_until_timeout",
      "death_policy": "block",
      "timeout_ticks": 600
    },
    {
      "alias": "route_keeper",
      "type": "villagerretaliation:villager",
      "required": true,
      "capabilities": [
        "villagerretaliation:capability/dialogue"
      ],
      "binding_source": "quest_provider",
      "replacement_policy": "fixed",
      "missing_actor_policy": "wait_until_timeout",
      "death_policy": "continue_with_snapshot",
      "timeout_ticks": 600
    }
  ],
  "steps": [
    {
      "id": "unroll_the_route",
      "type": "villagerretaliation:dialogue",
      "actors": [
        "route_keeper"
      ],
      "data": {
        "text": "The charcoal route is fixed. From here, every mark must survive fire and bad judgment.",
        "offline_policy": "wait",
        "offline_poll_ticks": 20
      },
      "next": "let_ink_dry",
      "failure_step": "failed"
    },
    {
      "id": "let_ink_dry",
      "type": "villagerretaliation:wait_ticks",
      "data": {
        "ticks": 35
      },
      "next": "read_road"
    },
    {
      "id": "read_road",
      "type": "villagerretaliation:scene_branch",
      "data": {
        "branches": [
          {
            "transition": "fortress",
            "conditions": [
              {
                "type": "quest_fact",
                "scope": "quest",
                "quest": "villagerretaliation:choose_a_road",
                "key": "choice",
                "value": "fortress"
              }
            ]
          }
        ],
        "default_transition": "bastion"
      },
      "transitions": {
        "fortress": "fortress_charge",
        "bastion": "bastion_charge"
      },
      "failure_step": "failed"
    },
    {
      "id": "fortress_charge",
      "type": "villagerretaliation:dialogue",
      "actors": [
        "route_keeper"
      ],
      "data": {
        "text": "Fortress road. Count blaze fire before every crossing, and bring back rods to mark the safe turns."
      },
      "next": "completed",
      "failure_step": "failed"
    },
    {
      "id": "bastion_charge",
      "type": "villagerretaliation:dialogue",
      "actors": [
        "route_keeper"
      ],
      "data": {
        "text": "Bastion road. Watch the brutes, trust no open chest, and bring gilded stone for the route ledger."
      },
      "next": "completed",
      "failure_step": "failed"
    },
    {
      "id": "completed",
      "type": "villagerretaliation:scene_complete"
    },
    {
      "id": "failed",
      "type": "villagerretaliation:scene_fail"
    }
  ]
}
