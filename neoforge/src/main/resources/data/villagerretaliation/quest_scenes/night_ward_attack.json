{
  "schema": "villagerretaliation:scene/v1",
  "id": "villagerretaliation:night_ward_attack",
  "definition_version": 1,
  "metadata": {
    "title": "Night Ward attack",
    "quest": "villagerretaliation:night_ward"
  },
  "ownership": "quest_instance",
  "entry_step": "ward_warning",
  "timeout_ticks": 3600,
  "failure_policy": "block_for_repair",
  "cancellation_policy": "cancel_scene",
  "cleanup_policy": "all_owned",
  "actors": [
    {
      "alias": "player",
      "type": "villagerretaliation:player",
      "required": true,
      "capabilities": [
        "villagerretaliation:capability/live_entity"
      ],
      "binding_source": "owner_player",
      "replacement_policy": "fixed",
      "missing_actor_policy": "wait_until_timeout",
      "death_policy": "block",
      "timeout_ticks": 1200
    },
    {
      "alias": "healer",
      "type": "villagerretaliation:villager",
      "required": false,
      "capabilities": [
        "villagerretaliation:capability/dialogue"
      ],
      "binding_source": "quest_provider",
      "replacement_policy": "compatible_replacement",
      "missing_actor_policy": "skip",
      "death_policy": "continue_with_snapshot",
      "timeout_ticks": 1200
    }
  ],
  "steps": [
    {
      "id": "ward_warning",
      "type": "villagerretaliation:dialogue",
      "actors": [
        "healer"
      ],
      "data": {
        "text": "The ward doors are barred. Three dead are pushing in from the dark—meet them outside.",
        "offline_policy": "wait",
        "offline_poll_ticks": 20
      },
      "next": "ready_the_ward",
      "failure_step": "failed"
    },
    {
      "id": "ready_the_ward",
      "type": "villagerretaliation:wait_ticks",
      "data": {
        "ticks": 30
      },
      "next": "start_attack"
    },
    {
      "id": "start_attack",
      "type": "villagerretaliation:start_encounter",
      "data": {
        "template": "villagerretaliation:night_ward_attack",
        "anchor_actor": "healer",
        "difficulty": "normal"
      },
      "next": "defend_ward",
      "failure_step": "failed"
    },
    {
      "id": "defend_ward",
      "type": "villagerretaliation:wait_encounter",
      "data": {
        "encounter_step": "start_attack"
      },
      "next": "clean_up",
      "failure_step": "failed"
    },
    {
      "id": "clean_up",
      "type": "villagerretaliation:cleanup_encounter",
      "data": {
        "encounter_step": "start_attack",
        "force_remove": false
      },
      "next": "samples_reminder",
      "failure_step": "failed"
    },
    {
      "id": "samples_reminder",
      "type": "villagerretaliation:dialogue",
      "actors": [
        "healer"
      ],
      "data": {
        "text": "The ward is quiet again. Gather six samples from the dead before the evidence spoils."
      },
      "next": "completed",
      "failure_step": "failed"
    },
    {
      "id": "completed",
      "type": "villagerretaliation:scene_complete"
    },
    {
      "id": "failed",
      "type": "villagerretaliation:scene_fail"
    }
  ]
}
