{
  "schema": "villagerretaliation:scene/v1",
  "id": "villagerretaliation:end_star_choice",
  "definition_version": 1,
  "metadata": {
    "title": "End star choice",
    "quest": "villagerretaliation:choose_a_star"
  },
  "ownership": "quest_instance",
  "entry_step": "mark_the_star",
  "timeout_ticks": 1200,
  "failure_policy": "block_for_repair",
  "cancellation_policy": "cancel_scene",
  "cleanup_policy": "none",
  "actors": [
    {
      "alias": "player",
      "type": "villagerretaliation:player",
      "required": true,
      "capabilities": [
        "villagerretaliation:capability/live_entity"
      ],
      "binding_source": "owner_player",
      "replacement_policy": "fixed",
      "missing_actor_policy": "wait_until_timeout",
      "death_policy": "block",
      "timeout_ticks": 600
    },
    {
      "alias": "surveyor",
      "type": "villagerretaliation:villager",
      "required": true,
      "capabilities": [
        "villagerretaliation:capability/dialogue"
      ],
      "binding_source": "quest_provider",
      "replacement_policy": "fixed",
      "missing_actor_policy": "wait_until_timeout",
      "death_policy": "continue_with_snapshot",
      "timeout_ticks": 600
    }
  ],
  "steps": [
    {
      "id": "mark_the_star",
      "type": "villagerretaliation:dialogue",
      "actors": [
        "surveyor"
      ],
      "data": {
        "text": "One point of End light is circled in the survey ledger. The route now belongs to your choice.",
        "offline_policy": "wait",
        "offline_poll_ticks": 20
      },
      "next": "watch_the_ink",
      "failure_step": "failed"
    },
    {
      "id": "watch_the_ink",
      "type": "villagerretaliation:wait_ticks",
      "data": {
        "ticks": 35
      },
      "next": "read_star"
    },
    {
      "id": "read_star",
      "type": "villagerretaliation:scene_branch",
      "data": {
        "branches": [
          {
            "transition": "chorus",
            "conditions": [
              {
                "type": "quest_fact",
                "scope": "quest",
                "quest": "villagerretaliation:choose_a_star",
                "key": "choice",
                "value": "chorus"
              }
            ]
          }
        ],
        "default_transition": "city"
      },
      "transitions": {
        "chorus": "chorus_charge",
        "city": "city_charge"
      },
      "failure_step": "failed"
    },
    {
      "id": "chorus_charge",
      "type": "villagerretaliation:dialogue",
      "actors": [
        "surveyor"
      ],
      "data": {
        "text": "Chorus trail. Map the living purple route, even when its fruit disagrees with distance."
      },
      "next": "completed",
      "failure_step": "failed"
    },
    {
      "id": "city_charge",
      "type": "villagerretaliation:dialogue",
      "actors": [
        "surveyor"
      ],
      "data": {
        "text": "City light. Map the pale towers, the void between them, and every shell pretending to be stone."
      },
      "next": "completed",
      "failure_step": "failed"
    },
    {
      "id": "completed",
      "type": "villagerretaliation:scene_complete"
    },
    {
      "id": "failed",
      "type": "villagerretaliation:scene_fail"
    }
  ]
}
