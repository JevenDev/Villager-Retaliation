{
  "schema": "villagerretaliation:scene/v1",
  "id": "villagerretaliation:atlas_risky_patrol",
  "definition_version": 1,
  "metadata": {
    "title": "Risky atlas patrol",
    "quest": "villagerretaliation:the_atlas_test",
    "route": "risky"
  },
  "ownership": "quest_instance",
  "entry_step": "patrol_warning",
  "timeout_ticks": 3600,
  "failure_policy": "block_for_repair",
  "cancellation_policy": "cancel_scene",
  "cleanup_policy": "all_owned",
  "actors": [
    {
      "alias": "player",
      "type": "villagerretaliation:player",
      "required": true,
      "capabilities": [
        "villagerretaliation:capability/live_entity"
      ],
      "binding_source": "owner_player",
      "replacement_policy": "fixed",
      "missing_actor_policy": "wait_until_timeout",
      "death_policy": "block",
      "timeout_ticks": 1200
    },
    {
      "alias": "cartographer",
      "type": "villagerretaliation:villager",
      "required": false,
      "capabilities": [
        "villagerretaliation:capability/dialogue"
      ],
      "binding_source": "quest_provider",
      "replacement_policy": "compatible_replacement",
      "missing_actor_policy": "skip",
      "death_policy": "continue_with_snapshot",
      "timeout_ticks": 1200
    }
  ],
  "steps": [
    {
      "id": "patrol_warning",
      "type": "villagerretaliation:dialogue",
      "actors": [
        "cartographer"
      ],
      "data": {
        "text": "The risky road has answered already. A pillager patrol is moving on this map table.",
        "offline_policy": "wait",
        "offline_poll_ticks": 20
      },
      "next": "draw_near",
      "failure_step": "failed"
    },
    {
      "id": "draw_near",
      "type": "villagerretaliation:wait_ticks",
      "data": {
        "ticks": 30
      },
      "next": "start_patrol"
    },
    {
      "id": "start_patrol",
      "type": "villagerretaliation:start_encounter",
      "data": {
        "template": "villagerretaliation:atlas_risky_patrol",
        "anchor_actor": "cartographer",
        "difficulty": "normal"
      },
      "next": "fight_patrol",
      "failure_step": "failed"
    },
    {
      "id": "fight_patrol",
      "type": "villagerretaliation:wait_encounter",
      "data": {
        "encounter_step": "start_patrol"
      },
      "next": "clean_up",
      "failure_step": "failed"
    },
    {
      "id": "clean_up",
      "type": "villagerretaliation:cleanup_encounter",
      "data": {
        "encounter_step": "start_patrol",
        "force_remove": false
      },
      "next": "patrol_cleared",
      "failure_step": "failed"
    },
    {
      "id": "patrol_cleared",
      "type": "villagerretaliation:dialogue",
      "actors": [
        "cartographer"
      ],
      "data": {
        "text": "That was the patrol. Keep one of their crossbows and the risky route has its proof."
      },
      "next": "completed",
      "failure_step": "failed"
    },
    {
      "id": "completed",
      "type": "villagerretaliation:scene_complete"
    },
    {
      "id": "failed",
      "type": "villagerretaliation:scene_fail"
    }
  ]
}
