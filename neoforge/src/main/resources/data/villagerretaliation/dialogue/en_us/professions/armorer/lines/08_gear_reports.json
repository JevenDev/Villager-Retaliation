    {
      "id": "gear_report_armorer_unused",
      "request": "gear_report",
      "lines": [
        "No dents yet. I can live with careful work staying untested.",
        "No test is good news.",
        "The polish remains whole.",
        "Nothing needed its protection.",
        "The fit is ready anyway.",
        "Keep the straps oiled.",
        "Quiet armor still matters.",
        "No dents means relief.",
        "Wear it enough to know it.",
        "The balance remains sound.",
        "Prepared and unused is fine.",
        "I prefer oiling to repairs.",
        "May it stay boring.",
        "The buckles have settled.",
        "Peace kept it clean.",
        "No danger had to judge it.",
        "It waits without complaint.",
        "Clean metal is a good report.",
        "Readiness needs no scars.",
        "Leave it close at night."
      ],
