      "lines": [
        "You will need to earn back my trust before I tend your wounds."
      ],
      "id": "global.messages.healing.refused"
    },
    {
      "key": "interaction.healing.unauthorized",
      "lines": [
        "I reserve these supplies for my party."
      ],
      "id": "global.messages.healing.unauthorized"
    },
    {
