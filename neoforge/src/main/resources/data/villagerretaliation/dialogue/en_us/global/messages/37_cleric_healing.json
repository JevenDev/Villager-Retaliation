    {
      "key": "interaction.healing.free",
      "lines": [
        "You have my help freely. Shall I tend your wounds?"
      ],
      "id": "global.messages.healing.free"
    },
    {
      "key": "interaction.healing.paid",
      "lines": [
        "Another healing potion will cost {cost} {currency}. Shall I?"
      ],
      "id": "global.messages.healing.paid"
    },
    {
      "key": "interaction.healing.supplied",
      "lines": [
        "I can use one of the healing potions you supplied. Shall I?"
      ],
      "id": "global.messages.healing.supplied"
    },
    {
      "key": "interaction.healing.disabled",
      "lines": [
        "I cannot offer healing right now."
      ],
      "id": "global.messages.healing.disabled"
    },
    {
