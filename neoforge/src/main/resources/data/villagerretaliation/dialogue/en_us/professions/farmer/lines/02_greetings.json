        {
          "id": "farmer.base.greeting_ordinary.hostile.6",
          "text": "I have little appetite for a chat with you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.hostile.7",
          "text": "Say what you need to say.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.hostile.8",
          "text": "Let's make this a short conversation.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.hostile.9",
          "text": "I can listen without making small talk.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.hostile.10",
          "text": "I'm here. Get on with it.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.despised.1",
          "text": "I have no interest in a friendly chat with you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.despised.2",
          "text": "Necessary business only.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.despised.3",
          "text": "Keep this to what needs saying.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.despised.4",
          "text": "Don't expect a warm welcome from me.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.despised.5",
          "text": "I'm willing to hear the matter, not exchange pleasantries.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.despised.6",
          "text": "There'll be no casual conversation between us.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.despised.7",
          "text": "Make your purpose clear, then leave me to myself.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.despised.8",
          "text": "I don't want your company. State the matter.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.despised.9",
          "text": "I have nothing friendly to offer you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.despised.10",
          "text": "Keep personal talk out of this.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.feared.1",
          "text": "Hello. Please give me a little room.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.feared.2",
          "text": "I'm listening. There's no need to come closer.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.feared.3",
          "text": "Hello. I'd like to keep this calm.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.feared.4",
          "text": "Please say what you need from there.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.feared.5",
          "text": "I can hear you. Take it slowly.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.feared.6",
          "text": "Hello. A short conversation would be enough for me.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.feared.7",
          "text": "I'm here. Please be clear about what you're asking.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.feared.8",
          "text": "I'd rather talk with some space between us.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.feared.9",
          "text": "Hello. Let me listen before I answer.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "farmer.base.greeting_ordinary.feared.10",
          "text": "Please give me a moment to collect myself.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "paired_greet.wellbeing.royalty.content",
          "text": "I'm feeling {word:villagerretaliation:mood/content}. It's kind of you to ask.",
          "conditions": [
            {
              "type": "reputation",
              "level": "royalty"
            },
            {
              "type": "villager_age",
              "adult": true
            },
            {
              "type": "mood",
              "mood": "content"
            }
          ]
        },
        {
          "id": "paired_greet.wellbeing.revered.content",
          "text": "I'm feeling {word:villagerretaliation:mood/content}. Thank you for asking.",
          "conditions": [
            {
              "type": "reputation",
              "level": "revered"
            },
            {
              "type": "villager_age",
              "adult": true
            },
            {
              "type": "mood",
              "mood": "content"
            }
          ]
        },
        {
          "id": "paired_greet.wellbeing.trusted.content",
          "text": "I'm feeling <aqua>{word:villagerretaliation:mood/content}</aqua>, thanks for asking.",
          "conditions": [
            {
              "type": "reputation",
              "level": "trusted"
            },
            {
              "type": "villager_age",
              "adult": true
            },
            {
              "type": "mood",
              "mood": "content"
            }
          ]
        },
        {
          "id": "paired_greet.wellbeing.neutral.content",
          "text": "I'm feeling {word:villagerretaliation:mood/content}, thank you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "neutral"
            },
            {
              "type": "villager_age",
              "adult": true
            },
            {
              "type": "mood",
              "mood": "content"
            }
          ]
        }
      ]
    }
