{
  "lines": [
    {
      "id": "farmer_new_greeting_rows",
      "request": "greeting",
      "weight": 26,
      "variants": [
        {
          "id": "line_0",
          "text": "Stay off the rows if you can. The crops remember boots."
        },
        {
          "id": "line_1",
          "text": "Give the fields room. Farming works better without elbows in it."
        },
        {
          "id": "line_2",
          "text": "Step carefully near the fields. I would rather greet you than patch you up."
        },
        {
          "id": "line_3",
          "text": "There you are. I was just near the fields, trying to keep the day sensible."
        },
        {
          "id": "line_4",
          "text": "Mind the rows. I just convinced them to behave."
        },
        {
          "id": "line_5",
          "text": "Hello. If this is about trampling crops, choose your words carefully."
        },
        {
          "id": "line_6",
          "text": "You caught me with dirt on my hands and work on my mind."
        },
        {
          "id": "line_7",
          "text": "The fields can wait a breath. What do you need?"
        },
        {
          "id": "line_8",
          "text": "Step where the path is. The soil and I both appreciate it."
        },
        {
          "id": "line_9",
          "text": "Morning. The crops are judging the weather and so am I."
        },
        {
          "id": "line_10",
          "text": "I have a moment before the next chore notices me."
        },
        {
          "id": "line_11",
          "text": "Come by the fence, not through the wheat."
        },
        {
          "id": "line_12",
          "text": "Good to see you arriving without a herd behind you."
        },
        {
          "id": "line_13",
          "text": "The day is growing whether I am ready or not."
        },
        {
          "id": "line_14",
          "text": "Speak up. The wind has been answering for people all morning."
        },
        {
          "id": "line_15",
          "text": "Hello there. If you brought rain, please be specific about how much."
        },
        {
          "id": "line_16",
          "text": "I was counting seedlings. Try not to distract me into starting over."
        },
        {
          "id": "line_17",
          "text": "Stand clear of the compost and we can talk like civilized folk."
        },
        {
          "id": "line_18",
          "text": "You have my attention until the field steals it back."
        },
        {
          "id": "line_19",
          "text": "Mind the rows and come closer if you need something."
        },
