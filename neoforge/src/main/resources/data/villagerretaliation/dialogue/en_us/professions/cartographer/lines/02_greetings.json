            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.hostile.5",
          "text": "You have a moment. Don't stretch it.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.hostile.6",
          "text": "I'm in no mood to make you welcome.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.hostile.7",
          "text": "State your business and leave the pleasantries.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.hostile.8",
          "text": "I can hear you. That doesn't mean I want company.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.hostile.9",
          "text": "Say what you need without making this personal.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.hostile.10",
          "text": "I have very little patience for a conversation with you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.despised.1",
          "text": "I don't welcome your company.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.despised.2",
          "text": "Keep this to whatever actually needs saying.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.despised.3",
          "text": "I have no wish to exchange greetings with you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.despised.4",
          "text": "Don't mistake my attention for an invitation to stay.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.despised.5",
          "text": "I won't pretend I'm pleased to see you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.despised.6",
          "text": "I want no more conversation than is necessary.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.despised.7",
          "text": "Spare me an attempt at friendly chatter.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.despised.8",
          "text": "I would rather you left me alone.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.despised.9",
          "text": "You won't get a warm reception from me.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.despised.10",
          "text": "I'm not interested in spending time with you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.feared.1",
          "text": "Hello. I'd prefer some room between us.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.feared.2",
          "text": "I'm listening. I'd like this to be a short conversation.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.feared.3",
          "text": "Please say what you need. I'm rather uneasy.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.feared.4",
          "text": "Hello. I'd feel better with some space between us.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.feared.5",
          "text": "I can answer briefly. Please don't press me to say more.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.feared.6",
          "text": "I'm here. There's no need to come any closer.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.feared.7",
          "text": "Please keep your voice calm. I'm finding this difficult.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.feared.8",
          "text": "Hello. I don't want a long exchange.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.feared.9",
          "text": "I'll try to speak clearly. I'd rather not be hurried.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cartographer.base.greeting_ordinary.feared.10",
          "text": "You have my attention. Please let me choose when I'm finished.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        }
      ]
    }
  ],
