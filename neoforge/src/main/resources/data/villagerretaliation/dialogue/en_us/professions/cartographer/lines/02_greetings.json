{
  "lines": [
    {
      "id": "cartographer_new_greeting_table",
      "request": "greeting",
      "weight": 26,
      "variants": [
        {
          "id": "line_0",
          "text": "Keep your hands off the map table unless you know where they are going."
        },
        {
          "id": "line_1",
          "text": "Give the map table room. Mapping works better without elbows in it."
        },
        {
          "id": "line_2",
          "text": "Step carefully near the map table. I would rather greet you than patch you up."
        },
        {
          "id": "line_3",
          "text": "There you are. I was just near the map table, trying to keep the day sensible."
        },
        {
          "id": "line_4",
          "text": "Mind the table. The ink is fresh and unforgiving."
        },
        {
          "id": "line_5",
          "text": "Hello. If you moved the compass, please confess gently."
        },
        {
          "id": "line_6",
          "text": "You caught me between one road and the next mistake."
        },
        {
          "id": "line_7",
          "text": "Step lightly. I am trying to keep the world flat for a moment."
        },
        {
          "id": "line_8",
          "text": "Good timing. The map was getting too confident."
        },
        {
          "id": "line_9",
          "text": "Welcome. Try not to lean on the wet corner."
        },
        {
          "id": "line_10",
          "text": "I have ink on my fingers and a little time for questions."
        },
        {
          "id": "line_11",
          "text": "If you came with directions, I already doubt them politely."
        },
        {
          "id": "line_12",
          "text": "There you are. I was just arguing with a coastline."
        },
        {
          "id": "line_13",
          "text": "Stand where you are. I need the light more than the company."
        },
        {
          "id": "line_14",
          "text": "Hello. The road can wait if you cannot."
        },
        {
          "id": "line_15",
          "text": "Keep clear of the quills unless you want to become a landmark."
        },
        {
          "id": "line_16",
          "text": "I am listening, though half my mind is still north of here."
        },
        {
          "id": "line_17",
          "text": "Come closer, but do not breathe on the ink."
        },
        {
          "id": "line_18",
          "text": "The table is crowded, but I can make room for a short talk."
        },
        {
          "id": "line_19",
          "text": "Come in. I was giving a stubborn road another look."
        },
