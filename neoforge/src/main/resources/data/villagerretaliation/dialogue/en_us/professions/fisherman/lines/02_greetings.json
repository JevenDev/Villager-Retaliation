{
  "lines": [
    {
      "id": "fisherman_new_greeting_dock",
      "request": "greeting",
      "weight": 26,
      "variants": [
        {
          "id": "line_0",
          "text": "Step lightly on the dock. Loose boards like to announce strangers."
        },
        {
          "id": "line_1",
          "text": "Give the dock room. Fishing works better without elbows in it."
        },
        {
          "id": "line_2",
          "text": "Step carefully near the dock. I would rather greet you than patch you up."
        },
        {
          "id": "line_3",
          "text": "There you are. I was just near the dock, trying to keep the day sensible."
        },
        {
          "id": "line_4",
          "text": "Watch your step. The dock is slick and proud of it."
        },
        {
          "id": "line_5",
          "text": "Hello. If you came for fish, lower your voice."
        },
        {
          "id": "line_6",
          "text": "You caught me before the line did."
        },
        {
          "id": "line_7",
          "text": "Mind the net. It catches ankles when the fish refuse."
        },
        {
          "id": "line_8",
          "text": "Morning. The water is pretending to be calm."
        },
        {
          "id": "line_9",
          "text": "I have a moment while the river ignores me."
        },
        {
          "id": "line_10",
          "text": "Stand there, unless you trust your balance more than I do."
        },
        {
          "id": "line_11",
          "text": "Good to see someone dry for a change."
        },
        {
          "id": "line_12",
          "text": "The boat is tied, the line is set, and I can talk."
        },
        {
          "id": "line_13",
          "text": "If this is urgent, say so before the bobber moves."
        },
        {
          "id": "line_14",
          "text": "Hello. Do not lean on that barrel unless you want a story."
        },
        {
          "id": "line_15",
          "text": "The wind is carrying half my patience away today."
        },
        {
          "id": "line_16",
          "text": "Come closer, but leave the net alone."
        },
        {
          "id": "line_17",
          "text": "I was counting hooks. I can start again after you speak."
        },
        {
          "id": "line_18",
          "text": "You have my ear until the water steals it."
        },
        {
          "id": "line_19",
          "text": "Good timing. I was about to take a break from the dock."
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.royalty.1",
          "text": "Hello. I'm very glad you came over.",
