        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.hostile.4",
          "text": "I'm not in the mood for pleasantries with you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.hostile.5",
          "text": "Say your piece. Keep it short.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.hostile.6",
          "text": "I would rather avoid a long conversation.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.hostile.7",
          "text": "You have my attention, not my enthusiasm.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.hostile.8",
          "text": "If there's something to say, say it plainly.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.hostile.9",
          "text": "Let's get through this without the friendly talk.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.hostile.10",
          "text": "I'm willing to hear the point, nothing more.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.feared.1",
          "text": "Yes. I hear you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.feared.2",
          "text": "Hello. Please say what you need to say.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.feared.3",
          "text": "I'm listening. I'd like to keep this short.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.feared.4",
          "text": "Let me find the words, please.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.feared.5",
          "text": "Hello. I'll try to answer clearly.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.feared.6",
          "text": "You have my attention. Please give me a moment.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.feared.7",
          "text": "I can hear you. There's no need to repeat it yet.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.feared.8",
          "text": "I'd rather speak a little at a time.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.feared.9",
          "text": "Hello. I don't have much to say myself.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "fisherman.personal_topic.greeting_ordinary.feared.10",
          "text": "I'll listen. Please let me finish if I answer.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        }
      ]
    }
  ],
