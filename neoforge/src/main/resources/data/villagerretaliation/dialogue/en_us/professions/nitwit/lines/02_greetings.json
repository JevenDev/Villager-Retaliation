              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.despised.1",
          "text": "It's you. You're no welcome sight to me.",
