              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.feared.1",
          "text": "Hello. I'm feeling uneasy.",
