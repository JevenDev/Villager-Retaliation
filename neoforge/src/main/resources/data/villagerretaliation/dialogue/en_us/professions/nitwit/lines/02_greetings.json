              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.despised.5",
          "text": "I see you. I would rather not.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.despised.6",
          "text": "There's nothing warm in my greeting to you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.despised.7",
          "text": "It's you. I won't pretend I'm glad.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.despised.8",
          "text": "It's you. I'll leave it at that.",
