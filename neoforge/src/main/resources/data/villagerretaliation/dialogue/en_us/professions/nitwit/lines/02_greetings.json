            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.despised.2",
          "text": "I've seen you. I have no greeting to offer.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.despised.3",
          "text": "I have no welcome for you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.despised.4",
          "text": "You won't get a friendly hello from me.",
