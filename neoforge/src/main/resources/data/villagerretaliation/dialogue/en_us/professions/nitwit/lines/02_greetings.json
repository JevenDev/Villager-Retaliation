          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.hostile.5",
          "text": "You have my attention, if not my welcome.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.hostile.6",
          "text": "Hello, then. I won't pretend to be delighted.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.hostile.7",
          "text": "I've seen you. There's no need for a friendly greeting.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.hostile.8",
          "text": "It's you. I'll leave the welcome at that.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "nitwit.base.greeting_ordinary.hostile.9",
          "text": "Hello. I'm not feeling welcoming toward you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
