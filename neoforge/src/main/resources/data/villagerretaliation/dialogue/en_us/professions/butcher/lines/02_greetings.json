          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.hostile.6",
          "text": "Say your piece, then.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.hostile.7",
          "text": "Hello there. Keep the conversation straightforward.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.hostile.8",
          "text": "You can speak. I'd prefer a short introduction.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.hostile.9",
          "text": "All right. I'm listening to you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.hostile.10",
          "text": "Hello. Start with what you're after.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.despised.1",
          "text": "Say what you've come to say.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.despised.2",
          "text": "I'm listening. Keep it to the point.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.despised.3",
          "text": "You can get to your question.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.despised.4",
          "text": "Hello. No ceremony needed.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.despised.5",
          "text": "Give me the short version of what's on your mind.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.despised.6",
          "text": "Go ahead. Spare me the grand opening.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.despised.7",
          "text": "Say it plainly. I'm listening.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.despised.8",
          "text": "You have my attention for the question.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.despised.9",
          "text": "All right. Get to the subject.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.despised.10",
          "text": "Hello. Keep the introduction short.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.feared.1",
          "text": "Hello. I'm listening to what you want to say.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.feared.2",
          "text": "I'm here. Please say what's on your mind.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.feared.3",
          "text": "Hello there. I'd like to understand you clearly.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.feared.4",
          "text": "Go ahead. I'll listen.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.feared.5",
          "text": "Hello. A plain question would help me.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.feared.6",
          "text": "You have my attention. I hope I can answer clearly.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "butcher.base.greeting_ordinary.feared.7",
          "text": "Hello there. I'm ready to hear what you mean.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
