{
  "lines": [
    {
      "id": "cleric_new_greeting_bottles",
      "request": "greeting",
      "weight": 26,
      "variants": [
        {
          "id": "line_0",
          "text": "Mind the bottles. I would rather greet you than clean up glass."
        },
        {
          "id": "line_1",
          "text": "Hello. Give me a moment to put this cork in."
        },
        {
          "id": "line_2",
          "text": "You look well enough to stand, which is a good start."
        },
        {
          "id": "line_3",
          "text": "Come in, but leave a clear path to the brewing stand."
        },
        {
          "id": "line_4",
          "text": "Good to see you. Are you hurt or only visiting?"
        },
        {
          "id": "line_5",
          "text": "Watch your sleeve near that flame."
        },
        {
          "id": "line_6",
          "text": "There you are. I was beginning to think the rain kept you away."
        },
        {
          "id": "line_7",
          "text": "Welcome. The room smells worse than the remedies taste."
        },
        {
          "id": "line_8",
          "text": "Careful by the shelf. I sorted those for a reason."
        },
        {
          "id": "line_9",
          "text": "Hello. Sit if your legs are less steady than your voice."
        },
        {
          "id": "line_10",
          "text": "You arrived between brews. That is fortunate."
        },
        {
          "id": "line_11",
          "text": "Come closer if you need help, but not too close to the fire."
        },
        {
          "id": "line_12",
          "text": "Good morning. I have clean water and a little time."
        },
        {
          "id": "line_13",
          "text": "If you are here for a potion, tell me what happened first."
        },
        {
          "id": "line_14",
          "text": "Welcome back. You look less troubled than last time."
        },
        {
          "id": "line_15",
          "text": "Mind the cat. It believes this is its workplace."
        },
        {
          "id": "line_16",
          "text": "Hello. I am listening, even if the stand is bubbling."
        },
        {
          "id": "line_17",
          "text": "Settle in. I only have one dangerous bottle open today."
        },
        {
          "id": "line_18",
          "text": "You caught me cleaning glass, which never seems to end."
        },
        {
          "id": "line_19",
          "text": "Good to see a familiar face on a quiet day."
        },
        {
