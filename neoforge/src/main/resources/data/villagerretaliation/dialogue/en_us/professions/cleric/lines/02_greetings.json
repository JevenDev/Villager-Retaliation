        {
          "id": "cleric.base.greeting_ordinary.hostile.5",
          "text": "Get to the point. I have no wish for small talk.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.hostile.6",
          "text": "I hear you. Say what's necessary.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.hostile.7",
          "text": "Hello there. I don't want a long conversation.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.hostile.8",
          "text": "You can speak. Don't mistake that for a welcome to linger.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.hostile.9",
          "text": "I'm willing to hear the matter, not pass the time.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.hostile.10",
          "text": "A brief word, then. That's enough.",
          "conditions": [
            {
              "type": "reputation",
              "level": "hostile"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.despised.1",
          "text": "I don't welcome your company. Say what's necessary.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.despised.2",
          "text": "No small talk. Get to the point.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.despised.3",
          "text": "I'm not pleased to see you. Keep your words brief.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.despised.4",
          "text": "Say what you must, then leave me be.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.despised.5",
          "text": "I have no friendly greeting for you.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.despised.6",
          "text": "This isn't a social visit I want. State your business.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.despised.7",
          "text": "I'm willing to hear only what needs saying.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.despised.8",
          "text": "Don't settle in for a conversation with me.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.despised.9",
          "text": "I don't want your company. If there's a matter to address, address it.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.despised.10",
          "text": "Make your point. I won't entertain a visit.",
          "conditions": [
            {
              "type": "reputation",
              "level": "despised"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.feared.1",
          "text": "Hello. I'd like to keep this short, please.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.feared.2",
          "text": "I'm listening. I may not have much to say.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.feared.3",
          "text": "Hello there. I'll hear you from here.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.feared.4",
          "text": "Yes, hello. A brief word would be best for me.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.feared.5",
          "text": "I can listen for a moment. Please give me room.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.feared.6",
          "text": "Hello. I'd prefer a little distance while we speak.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.feared.7",
          "text": "You have my attention. I don't want a long conversation.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.feared.8",
          "text": "Hello there. Please let me take this slowly.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.feared.9",
          "text": "I'm listening to you. That's all I can offer just now.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        },
        {
          "id": "cleric.base.greeting_ordinary.feared.10",
          "text": "Hello. I'd like a moment to find my words.",
          "conditions": [
            {
              "type": "reputation",
              "level": "feared"
            },
            {
              "type": "villager_age",
              "adult": true
            }
          ]
        }
      ]
    }
