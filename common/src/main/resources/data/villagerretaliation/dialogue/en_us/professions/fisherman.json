{
  "messages": [
    {
      "key": "gift_given",
      "text": "Take {gift_item}. A useful catch should not sit in one pair of hands.",
      "weight": 24
    },
    {
      "key": "gift_given",
      "text": "Here, {gift_item}. The water was generous, so I can be too.",
      "weight": 24
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Good. {tested_villager} took {gift_item}; that advice had a clean hook.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Then {gift_item} was the right bait for {tested_villager}. Glad it landed.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "That line came back empty. For {gift_subject}, cast {alternative_gift} instead.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "Some fish spit the hook. Leave {gift_item} and try {alternative_gift} next time.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "Bad bait. It happens. Cast {alternative_gift} if you want a better chance.",
      "dispositions": [
        "cautious",
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 20
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "You took the line, not me. Still, {alternative_gift} should catch better.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 20
    }
  ],
  "openings": [
    {
      "id": "fisherman_opening",
      "text": "Mind the dock. What do you need?"
    }
  ],
  "closings": [
    {
      "id": "fisherman_closing",
      "text": "Back to reading water and weather, then."
    }
  ],
  "lines": [
    {
      "id": "fisherman_chat_nets",
      "type": "chat",
      "text": "Empty nets at dusk make every rumor sound heavier.",
      "weight": 30
    },
    {
      "id": "fisherman_question_water",
      "type": "question",
      "text": "Water keeps secrets until the weather shakes them loose.",
      "weight": 30
    },
    {
      "id": "fisherman_story_line",
      "type": "story",
      "text": "A snapped line once saved me from hauling in something worse than nothing.",
      "weight": 26
    },
    {
      "id": "fisherman_new_greeting_dock",
      "type": "greeting",
      "text": "Step lightly on the dock. Loose boards like to announce strangers.",
      "weight": 26
    },
    {
      "id": "fisherman_new_chat_water",
      "type": "chat",
      "text": "Water looks calm right up until it proves it was thinking.",
      "weight": 28
    },
    {
      "id": "fisherman_new_question_nets",
      "type": "question",
      "text": "A good net catches food. A bad net catches excuses.",
      "weight": 28
    },
    {
      "id": "fisherman_new_story_fog",
      "type": "story",
      "text": "Once the fog came in so thick I trusted the dock by smell.",
      "weight": 24
    },
    {
      "id": "fisherman_new_joke_line",
      "type": "joke",
      "text": "A fishing joke needs a good line and someone patient enough to hear it.",
      "weight": 18
    },
    {
      "id": "fisherman_new_insult_soggy",
      "type": "insult",
      "text": "That insult was damp before it reached me.",
      "weight": 18
    },
    {
      "id": "fisherman_new_chat_weather",
      "type": "chat",
      "text": "Weather has more moods than any trader I have met.",
      "weight": 28
    },
    {
      "id": "fisherman_new_question_twine",
      "type": "question",
      "text": "Good twine matters. Small failures love important moments.",
      "weight": 28
    },
    {
      "id": "fisherman_new_story_empty_net",
      "type": "story",
      "text": "An empty net can still bring home a lesson, though nobody cooks it.",
      "weight": 24
    },
    {
      "id": "fisherman_new_cautious_distance",
      "type": "chat",
      "text": "I keep space between myself and uncertain weather. People are no different.",
      "dispositions": [
        "cautious",
        "rude"
      ],
      "weight": 30
    },
    {
      "id": "fisherman_cured_recognition_warm_1",
      "type": "cured_recognition",
      "text": "I remember sinking far below myself. You hauled the line in.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "fisherman_cured_recognition_warm_2",
      "type": "cured_recognition",
      "text": "The dark had me hooked. You cut the line clean.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "fisherman_cured_recognition_confused_1",
      "type": "cured_recognition",
      "text": "Your face breaks the surface of that memory, then slips under again.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "fisherman_cured_recognition_confused_2",
      "type": "cured_recognition",
      "text": "I remember a taste like bad river water, then breathing like it was new.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "fisherman_cured_recognition_uneasy_1",
      "type": "cured_recognition",
      "text": "I remember you through deep water and panic. Do not crowd the bank.",
      "weight": 30,
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ]
    },
    {
      "id": "fisherman_village_event_thunderstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "The nets and docks took the thunder badly, but everyone near my station is breathing.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_thunderstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I checked the nets and docks first, then the people. Both needed steady hands.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_thunderstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "That storm rattled the nets and docks; it rattled us more.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_thunderstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "Lightning makes every trade feel small. We are safe enough for now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_thunderstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I will trust the sky again when it stops threatening the roof.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_fire_1",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "I checked the nets and docks for sparks. Then I checked faces for fear.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_fire_2",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Smoke gets into everything: lungs, clothes, and the way people talk afterward.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_fire_3",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "The nets and docks can be replaced. People cannot. That is the count that matters.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_fire_4",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "We saved what hands could reach before the flames decided otherwise.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_fire_5",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Fire teaches quick priorities. Water, exits, children, neighbors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_raid_1",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "During a raid, the nets and docks matters less than who makes it behind a door.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_raid_2",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "The horns stopped, but my hands still expect more trouble.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_raid_3",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "We counted survivors before supplies. That is the right order.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_raid_4",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "Raiders came looking for weakness. They found a village that remembers how to stand.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_raid_5",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "I saw fear move through the village and courage move faster.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_night_attack_1",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Night trouble always finds the loose latch first. We are fixing those now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_night_attack_2",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "I kept near the nets and docks and listened for anyone calling for help.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_night_attack_3",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Dawn did not erase the attack, but it gave us light to count by.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_night_attack_4",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "The dark tested everyone. Most of us passed by staying alive.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_night_attack_5",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "We are safe enough, though every shadow is getting inspected twice.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_sandstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "The nets and docks collected half the desert, but the people made it indoors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_sandstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "I checked the nets and docks, then checked who was coughing from the dust.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_sandstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Sand in the hinges, sand in the eyes, but no one missing so far.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_sandstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Harsh wind teaches you which doors really close.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_sandstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "We are safe enough, though the village sounds like it is grinding its teeth.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_snowstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The nets and docks can wait. Warm hands and clear paths matter first.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_snowstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Snow piled against the doors, but everyone near me found shelter.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_snowstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Cold works quietly. We are checking on anyone who went quiet too long.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_snowstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The nets and docks froze stiff, but the village kept moving.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_village_event_snowstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "We are alright for now. Keep the fires fed and the paths open.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "fisherman_share_story_1",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "{target_article}, hm. Some places are hooks, and travelers are the bait.",
      "weight": 24
    },
    {
      "id": "fisherman_share_story_2",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "You saw {target} and came back. That is the part of the tale I like best.",
      "weight": 24
    },
    {
      "id": "fisherman_share_story_3",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "I will tell anyone casting lines near that road to keep one eye on {target}.",
      "weight": 24
    },
    {
      "id": "fisherman_share_story_4",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "A bad current is still water until it pulls. Sounds like {target_article} pulls hard.",
      "weight": 24
    },
    {
      "id": "fisherman_share_story_5",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "Stories like {target} travel farther than boats when people listen.",
      "weight": 24
    }
  ],
  "pacify": [
    {
      "id": "fisherman_pacify_success",
      "outcomes": [
        "success"
      ],
      "text": "Fine. The line goes slack, for now.",
      "weight": 26
    },
    {
      "id": "fisherman_pacify_short",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "That offer will not hold. I need {emerald_cost} {emeralds}.",
      "weight": 26
    },
    {
      "id": "fisherman_pacify_blocked",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "No. I know when to cut a bad line.",
      "weight": 26
    }
  ]
}
