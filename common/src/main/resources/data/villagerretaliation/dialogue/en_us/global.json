  "pacify": [
    {
      "id": "global_pacify_success_1",
      "outcomes": [
        "success"
      ],
      "text": "Fine. I will stand down, but peace takes more than emeralds.",
      "weight": 20
    },
    {
      "id": "global_pacify_success_2",
      "outcomes": [
        "success"
      ],
      "text": "I will let this pass for now. Do not make me regret it.",
      "weight": 20
    },
    {
      "id": "global_pacify_success_3",
      "outcomes": [
        "success"
      ],
      "text": "That is enough to cool my temper. Keep your hands peaceful.",
      "weight": 20
    },
    {
      "id": "global_pacify_short_1",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "That is not enough. Bring {emerald_cost} {emeralds} if you want this settled.",
      "weight": 20
    },
    {
      "id": "global_pacify_short_2",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "You are short. Peace costs {emerald_cost} {emeralds} today.",
      "weight": 20
    },
    {
      "id": "global_pacify_short_3",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "A small offer will not calm a large mistake. I need {emerald_cost} {emeralds}.",
      "weight": 20
    },
    {
      "id": "global_pacify_blocked_1",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "No. Some things are not bought back with emeralds.",
      "dispositions": [
        "hostile",
        "fearful"
      ],
      "weight": 24
    },
    {
      "id": "global_pacify_blocked_2",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "Keep them. I do not trust your apology.",
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 24
    },
    {
      "id": "global_pacify_blocked_3",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "The village remembers too much for that to work.",
      "dispositions": [
        "hostile",
        "fearful"
      ],
      "weight": 24
    }
  ]
