{
  "openings": [
    {
      "id": "global_friendly_opening",
      "text": "Good to see you. What can I do for you?",
      "dispositions": [
        "respectful",
        "friendly"
      ]
    },
    {
      "id": "global_neutral_opening",
      "text": "Hello. What brings you here?",
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "global_hostile_opening",
      "text": "You should make this quick.",
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ]
    }
  ],
  "closings": [
    {
      "id": "global_friendly_closing",
      "text": "Safe travels. Come by again.",
      "dispositions": [
        "respectful",
        "friendly"
      ]
    },
    {
      "id": "global_neutral_closing",
      "text": "Until next time.",
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "global_hostile_closing",
      "text": "That is enough for now.",
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ]
    }
  ],
  "lines": [
    {
      "id": "global_chat_paths",
      "type": "chat",
      "text": "The paths tell you plenty if you watch who hurries and who lingers.",
      "weight": 22
    },
    {
      "id": "global_question_trust",
      "type": "question",
      "text": "Trust is built from small things. Villages are very good at counting small things.",
      "weight": 24
    },
    {
      "id": "global_story_bell",
      "type": "story",
      "text": "Once the bell rang for a wandering cat. Everyone still claims they were not scared.",
      "weight": 20
    },
    {
      "id": "global_hit_memory",
      "type": "chat",
      "text": "I still remember that {attack_weapon}. Conversations get colder after that.",
      "requires_recent_direct_hit_memory": true,
      "dispositions": [
        "cautious",
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 48
    },
    {
      "id": "global_new_greeting_bell",
      "type": "greeting",
      "text": "The bell has been quiet today. I would like to keep it that way.",
      "weight": 22
    },
    {
      "id": "global_new_chat_square",
      "type": "chat",
      "text": "The square tells you who is busy, who is worried, and who is pretending not to be either.",
      "weight": 22
    },
    {
      "id": "global_new_question_doors",
      "type": "question",
      "text": "Why do we shut doors early? Because night makes ordinary mistakes harder to fix.",
      "weight": 22
    },
    {
      "id": "global_new_story_roof",
      "type": "story",
      "text": "One season, half the village learned roofing because the rain would not stop teaching.",
      "weight": 20
    },
    {
      "id": "global_new_joke_emerald",
      "type": "joke",
      "text": "I know an emerald joke, but it costs extra if you want the good part.",
      "weight": 18
    },
    {
      "id": "global_new_insult_path",
      "type": "insult",
      "text": "You walk like the path owes you an apology.",
      "weight": 18
    },
    {
      "id": "global_new_chat_work",
      "type": "chat",
      "text": "Most village work is simple until everyone depends on it being done right.",
      "weight": 22
    },
    {
      "id": "global_new_question_memory",
      "type": "question",
      "text": "What do villagers remember? More than visitors hope, less than rumors claim.",
      "weight": 22
    },
    {
      "id": "global_new_story_well",
      "type": "story",
      "text": "The well once went dry for a morning, and suddenly every bucket had a reputation.",
      "weight": 20
    },
    {
      "id": "global_new_hit_memory",
      "type": "chat",
      "text": "It is hard to speak plainly while remembering that {attack_weapon}.",
      "requires_recent_direct_hit_memory": true,
      "dispositions": [
        "cautious",
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 48
    }
  ],
  "pacify": [
    {
      "id": "global_pacify_success_1",
      "outcomes": [
        "success"
      ],
      "text": "Fine. I will stand down, but peace takes more than emeralds.",
      "weight": 20
    },
    {
      "id": "global_pacify_success_2",
      "outcomes": [
        "success"
      ],
      "text": "I will let this pass for now. Do not make me regret it.",
      "weight": 20
    },
    {
      "id": "global_pacify_success_3",
      "outcomes": [
        "success"
      ],
      "text": "That is enough to cool my temper. Keep your hands peaceful.",
      "weight": 20
    },
    {
      "id": "global_pacify_short_1",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "That is not enough. Bring {emerald_cost} {emeralds} if you want this settled.",
      "weight": 20
    },
    {
      "id": "global_pacify_short_2",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "You are short. Peace costs {emerald_cost} {emeralds} today.",
      "weight": 20
    },
    {
      "id": "global_pacify_short_3",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "A small offer will not calm a large mistake. I need {emerald_cost} {emeralds}.",
      "weight": 20
    },
    {
      "id": "global_pacify_blocked_1",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "No. Some things are not bought back with emeralds.",
      "dispositions": [
        "hostile",
        "fearful"
      ],
      "weight": 24
    },
    {
      "id": "global_pacify_blocked_2",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "Keep them. I do not trust your apology.",
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 24
    },
    {
      "id": "global_pacify_blocked_3",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "The village remembers too much for that to work.",
      "dispositions": [
        "hostile",
        "fearful"
      ],
      "weight": 24
    }
  ]
}
