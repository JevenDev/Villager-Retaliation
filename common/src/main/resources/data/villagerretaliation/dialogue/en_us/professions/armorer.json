{
  "messages": [
    {
      "key": "gift_given",
      "text": "Here, {gift_item}. Well-kept armor is not the only thing that protects a friend.",
      "weight": 24
    },
    {
      "key": "gift_given",
      "text": "Take {gift_item}. I would rather see you prepared than patched up later.",
      "weight": 24
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Good. {gift_item} held like proper mail for {tested_villager}. Advice should take a dent and stay useful.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "I thought {gift_item} would fit. Glad {tested_villager} wore the gesture well.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "Then that fit was off. For {gift_subject}, try {alternative_gift}; better plate, fewer gaps.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "A poor fitting, then. Bring {alternative_gift} next time and the trade should sit easier.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "You trusted a cracked plate. That is on both of us. Try {alternative_gift}.",
      "dispositions": [
        "cautious",
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 20
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "{gift_item} buckled? Fine. {alternative_gift} should hold better.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 20
    }
  ],
  "openings": [
    {
      "id": "armorer_opening",
      "text": "Mind the forge. What do you need?"
    }
  ],
  "closings": [
    {
      "id": "armorer_closing",
      "text": "Back to fitting mail and shields, then."
    }
  ],
  "lines": [
    {
      "id": "armorer_chat_work",
      "type": "chat",
      "text": "Most of my day is fitting mail and shields. It sounds simple until everything depends on it.",
      "weight": 30
    },
    {
      "id": "armorer_question_plates",
      "type": "question",
      "text": "A cracked plate after a raid teaches more than a quiet week ever does.",
      "weight": 30
    },
    {
      "id": "armorer_story_shield",
      "type": "story",
      "text": "A good shield is a promise you test before anyone needs it.",
      "weight": 26
    },
    {
      "id": "armorer_new_greeting_heat",
      "type": "greeting",
      "text": "Stand clear of the heat. A forge forgives less than I do.",
      "weight": 26
    },
    {
      "id": "armorer_new_chat_straps",
      "type": "chat",
      "text": "A loose strap looks harmless until someone trusts it in a fight.",
      "weight": 28
    },
    {
      "id": "armorer_new_question_mail",
      "type": "question",
      "text": "Good mail is not heavy. Bad mail reminds you of itself all day.",
      "weight": 28
    },
    {
      "id": "armorer_new_story_helmet",
      "type": "story",
      "text": "I once fixed a helmet so dented it looked like it had argued with the ground.",
      "weight": 24
    },
    {
      "id": "armorer_new_joke_padding",
      "type": "joke",
      "text": "Armor jokes need padding. Otherwise everyone feels the point too soon.",
      "weight": 18
    },
    {
      "id": "armorer_new_insult_rust",
      "type": "insult",
      "text": "That remark had the polish of wet rust.",
      "weight": 18
    },
    {
      "id": "armorer_new_chat_plate",
      "type": "chat",
      "text": "Every plate I fit is a small promise that someone gets another chance.",
      "weight": 28
    },
    {
      "id": "armorer_new_question_shield",
      "type": "question",
      "text": "A shield is only useful if the arm behind it holds steady.",
      "weight": 28
    },
    {
      "id": "armorer_new_story_raid",
      "type": "story",
      "text": "After a raid, you learn which buckles were honest and which only looked brave.",
      "weight": 24
    },
    {
      "id": "armorer_new_hostile_tools",
      "type": "insult",
      "text": "Do not sneer at my tools. They protect better people than you.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 30
    },
    {
      "id": "armorer_cured_recognition_warm_1",
      "type": "cured_recognition",
      "text": "I remember your hands at the edge of the dark. Stronger than any plate I have hammered.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "armorer_cured_recognition_warm_2",
      "type": "cured_recognition",
      "text": "A cure is armor for the soul. You helped fit mine back on.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "armorer_cured_recognition_confused_1",
      "type": "cured_recognition",
      "text": "I know your face, but the memory rings like a dented helm.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "armorer_cured_recognition_confused_2",
      "type": "cured_recognition",
      "text": "There was iron in my mouth, or fear, or both. Then you were there.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "armorer_cured_recognition_uneasy_1",
      "type": "cured_recognition",
      "text": "I remember you through cracked mail and bad dreams. Stand where I can see your hands.",
      "weight": 30,
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ]
    },
    {
      "id": "armorer_village_event_thunderstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "The armor and shields took the thunder badly, but everyone near my station is breathing.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_thunderstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I checked the armor and shields first, then the people. Both needed steady hands.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_thunderstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "That storm rattled the armor and shields; it rattled us more.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_thunderstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "Lightning makes every trade feel small. We are safe enough for now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_thunderstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I will trust the sky again when it stops threatening the roof.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_fire_1",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "I checked the armor and shields for sparks. Then I checked faces for fear.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_fire_2",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Smoke gets into everything: lungs, clothes, and the way people talk afterward.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_fire_3",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "The armor and shields can be replaced. People cannot. That is the count that matters.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_fire_4",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "We saved what hands could reach before the flames decided otherwise.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_fire_5",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Fire teaches quick priorities. Water, exits, children, neighbors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_raid_1",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "During a raid, the armor and shields matters less than who makes it behind a door.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_raid_2",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "The horns stopped, but my hands still expect more trouble.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_raid_3",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "We counted survivors before supplies. That is the right order.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_raid_4",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "Raiders came looking for weakness. They found a village that remembers how to stand.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_raid_5",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "I saw fear move through the village and courage move faster.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_night_attack_1",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Night trouble always finds the loose latch first. We are fixing those now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_night_attack_2",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "I kept near the armor and shields and listened for anyone calling for help.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_night_attack_3",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Dawn did not erase the attack, but it gave us light to count by.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_night_attack_4",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "The dark tested everyone. Most of us passed by staying alive.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_night_attack_5",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "We are safe enough, though every shadow is getting inspected twice.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_sandstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "The armor and shields collected half the desert, but the people made it indoors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_sandstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "I checked the armor and shields, then checked who was coughing from the dust.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_sandstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Sand in the hinges, sand in the eyes, but no one missing so far.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_sandstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Harsh wind teaches you which doors really close.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_sandstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "We are safe enough, though the village sounds like it is grinding its teeth.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_snowstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The armor and shields can wait. Warm hands and clear paths matter first.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_snowstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Snow piled against the doors, but everyone near me found shelter.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_snowstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Cold works quietly. We are checking on anyone who went quiet too long.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_snowstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The armor and shields froze stiff, but the village kept moving.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "armorer_village_event_snowstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "We are alright for now. Keep the fires fed and the paths open.",
      "weight": 34,
      "show_for_babies": false
    }
  ],
  "pacify": [
    {
      "id": "armorer_pacify_success",
      "outcomes": [
        "success"
      ],
      "text": "Fine. I will lower my guard, but I am keeping the straps tight.",
      "weight": 26
    },
    {
      "id": "armorer_pacify_short",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "That will not cover the dent you put in my patience. It takes {emerald_cost} {emeralds}.",
      "weight": 26
    },
    {
      "id": "armorer_pacify_blocked",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "No. Armor is for people I mean to protect, and that is not you right now.",
      "weight": 26
    }
  ]
}
