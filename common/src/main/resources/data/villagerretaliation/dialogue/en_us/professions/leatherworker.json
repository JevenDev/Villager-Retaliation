{
  "messages": [
    {
      "key": "gift_given",
      "text": "Take {gift_item}. Good gear should travel, not gather dust.",
      "weight": 24
    },
    {
      "key": "gift_given",
      "text": "Here, {gift_item}. It has more use with you than sitting by my cauldron.",
      "weight": 24
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Good. {gift_item} sat well with {tested_villager}, like softened leather.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Then the fit was comfortable. {tested_villager} liked {gift_item}.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "Too stiff for them, then. For {gift_subject}, try {alternative_gift}.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "{gift_item} rubbed wrong? Bring {alternative_gift}; better fit, less complaint.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "That advice chafed. {alternative_gift} should sit easier.",
      "dispositions": [
        "cautious",
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 20
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "You wore bad advice too long. Trade it for {alternative_gift}.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 20
    }
  ],
  "openings": [
    {
      "id": "leatherworker_opening",
      "text": "Mind the tannery. What do you need?"
    }
  ],
  "closings": [
    {
      "id": "leatherworker_closing",
      "text": "Back to curing leather without wasting hide, then."
    }
  ],
  "lines": [
    {
      "id": "leatherworker_chat_stitching",
      "type": "chat",
      "text": "Bad stitching in the rain tells on itself quickly.",
      "weight": 30
    },
    {
      "id": "leatherworker_question_gear",
      "type": "question",
      "text": "Gear that lasts is mostly patience made visible.",
      "weight": 30
    },
    {
      "id": "leatherworker_story_hide",
      "type": "story",
      "text": "A split seam can ruin a journey faster than a bad map.",
      "weight": 26
    },
    {
      "id": "leatherworker_new_greeting_tannery",
      "type": "greeting",
      "text": "Mind the tannery. The smell is honest, at least.",
      "weight": 26
    },
    {
      "id": "leatherworker_new_chat_stitch",
      "type": "chat",
      "text": "A stitch done poorly waits for the worst time to confess.",
      "weight": 28
    },
    {
      "id": "leatherworker_new_question_hide",
      "type": "question",
      "text": "Good leather is patience you can wear.",
      "weight": 28
    },
    {
      "id": "leatherworker_new_story_boots",
      "type": "story",
      "text": "I once made boots that outlasted three owners and four bad roads.",
      "weight": 24
    },
    {
      "id": "leatherworker_new_joke_skin",
      "type": "joke",
      "text": "Leather jokes need a thick skin. I keep saying that until someone laughs.",
      "weight": 18
    },
    {
      "id": "leatherworker_new_insult_split",
      "type": "insult",
      "text": "That sentence split like cheap stitching.",
      "weight": 18
    },
    {
      "id": "leatherworker_new_chat_rain",
      "type": "chat",
      "text": "Rain tells the truth about gear faster than any seller will.",
      "weight": 28
    },
    {
      "id": "leatherworker_new_question_gear",
      "type": "question",
      "text": "A pack should carry weight without reminding you every step.",
      "weight": 28
    },
    {
      "id": "leatherworker_new_story_apron",
      "type": "story",
      "text": "My apron has seen enough mistakes to deserve its own corner by the fire.",
      "weight": 24
    },
    {
      "id": "leatherworker_new_rude_work",
      "type": "insult",
      "text": "Do not mock work that lasts longer than your manners.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 30
    },
    {
      "id": "leatherworker_cured_recognition_warm_1",
      "type": "cured_recognition",
      "text": "I remember being stitched back into myself. Your hands held the thread.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "leatherworker_cured_recognition_warm_2",
      "type": "cured_recognition",
      "text": "The cure left scars, but good leather can carry scars. So can I.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "leatherworker_cured_recognition_confused_1",
      "type": "cured_recognition",
      "text": "Your face is worn into the memory, but the edges are rough.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "leatherworker_cured_recognition_confused_2",
      "type": "cured_recognition",
      "text": "I remember straps, shaking, and a second chance pulled tight.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "leatherworker_cured_recognition_uneasy_1",
      "type": "cured_recognition",
      "text": "I remember you, and I remember the tearing. Both are true.",
      "weight": 30,
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ]
    },
    {
      "id": "leatherworker_village_event_thunderstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "The stitches and straps took the thunder badly, but everyone near my station is breathing.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_thunderstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I checked the stitches and straps first, then the people. Both needed steady hands.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_thunderstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "That storm rattled the stitches and straps; it rattled us more.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_thunderstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "Lightning makes every trade feel small. We are safe enough for now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_thunderstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I will trust the sky again when it stops threatening the roof.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_fire_1",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "I checked the stitches and straps for sparks. Then I checked faces for fear.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_fire_2",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Smoke gets into everything: lungs, clothes, and the way people talk afterward.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_fire_3",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "The stitches and straps can be replaced. People cannot. That is the count that matters.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_fire_4",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "We saved what hands could reach before the flames decided otherwise.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_fire_5",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Fire teaches quick priorities. Water, exits, children, neighbors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_raid_1",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "During a raid, the stitches and straps matters less than who makes it behind a door.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_raid_2",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "The horns stopped, but my hands still expect more trouble.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_raid_3",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "We counted survivors before supplies. That is the right order.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_raid_4",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "Raiders came looking for weakness. They found a village that remembers how to stand.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_raid_5",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "I saw fear move through the village and courage move faster.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_night_attack_1",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Night trouble always finds the loose latch first. We are fixing those now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_night_attack_2",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "I kept near the stitches and straps and listened for anyone calling for help.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_night_attack_3",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Dawn did not erase the attack, but it gave us light to count by.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_night_attack_4",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "The dark tested everyone. Most of us passed by staying alive.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_night_attack_5",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "We are safe enough, though every shadow is getting inspected twice.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_sandstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "The stitches and straps collected half the desert, but the people made it indoors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_sandstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "I checked the stitches and straps, then checked who was coughing from the dust.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_sandstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Sand in the hinges, sand in the eyes, but no one missing so far.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_sandstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Harsh wind teaches you which doors really close.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_sandstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "We are safe enough, though the village sounds like it is grinding its teeth.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_snowstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The stitches and straps can wait. Warm hands and clear paths matter first.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_snowstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Snow piled against the doors, but everyone near me found shelter.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_snowstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Cold works quietly. We are checking on anyone who went quiet too long.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_snowstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The stitches and straps froze stiff, but the village kept moving.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_village_event_snowstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "We are alright for now. Keep the fires fed and the paths open.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "leatherworker_share_story_1",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "{target_article}. Wear boots you can run in if you go back.",
      "weight": 24
    },
    {
      "id": "leatherworker_share_story_2",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "I can mend torn leather. I cannot mend what places like {target} do to a careless traveler.",
      "weight": 24
    },
    {
      "id": "leatherworker_share_story_3",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "A warning about {target_article} fits better than any saddle: snug, useful, and meant to travel.",
      "weight": 24
    },
    {
      "id": "leatherworker_share_story_4",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "I will tell the caravan folk to check straps before passing near {target}.",
      "weight": 24
    },
    {
      "id": "leatherworker_share_story_5",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "You brought back the story and your skin. That is enough luck for one visit to {target_article}.",
      "weight": 24
    }
  ],
  "pacify": [
    {
      "id": "leatherworker_pacify_success",
      "outcomes": [
        "success"
      ],
      "text": "Fine. I will stitch this shut for now.",
      "weight": 26
    },
    {
      "id": "leatherworker_pacify_short",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "That is not enough to mend it. Bring {emerald_cost} {emeralds}.",
      "weight": 26
    },
    {
      "id": "leatherworker_pacify_blocked",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "No. This split runs too deep for emeralds.",
      "weight": 26
    }
  ]
}
