{
  "messages": [
    {
      "key": "gift_given",
      "text": "Take {gift_item}. I was saving it for a very good reason I forgot.",
      "weight": 24
    },
    {
      "key": "gift_given",
      "text": "Here, {gift_item}. It feels like the sort of thing a friend should have.",
      "weight": 24
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "See? {tested_villager} liked {gift_item}. I am occasionally brilliant by accident.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Ha! {gift_item} worked. I will be unbearable about this for at least a minute.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "Oh. Then pretend I said {alternative_gift}. For {gift_subject}, that sounds much wiser.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "{gift_item} failed? Strange. Try {alternative_gift}; my second guesses are famous to me.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "That was advice? I thought we were guessing. Guess {alternative_gift} next.",
      "dispositions": [
        "cautious",
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 20
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "You tried it anyway? Bold. I respect that almost enough to suggest {alternative_gift}.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 20
    }
  ],
  "openings": [
    {
      "id": "nitwit_opening",
      "text": "Mind the sunny corner. What do you need?"
    }
  ],
  "closings": [
    {
      "id": "nitwit_closing",
      "text": "Back to finding odd jobs and stranger thoughts, then."
    }
  ],
  "lines": [
    {
      "id": "nitwit_chat_thought",
      "type": "chat",
      "text": "I had a thought once. Left it somewhere safe, probably.",
      "weight": 30
    },
    {
      "id": "nitwit_question_thinking",
      "type": "question",
      "text": "If you find my thought, tell it I was looking useful.",
      "weight": 30
    },
    {
      "id": "nitwit_story_stick",
      "type": "story",
      "text": "A nice stick can be many things if nobody important is watching.",
      "weight": 26
    },
    {
      "id": "nitwit_new_greeting_corner",
      "type": "greeting",
      "text": "Hello. I was keeping this corner company.",
      "weight": 26
    },
    {
      "id": "nitwit_new_chat_button",
      "type": "chat",
      "text": "I found a button once. No wall, just ambition.",
      "weight": 28
    },
    {
      "id": "nitwit_new_question_where",
      "type": "question",
      "text": "Where am I going? Usually somewhere nearby, once I remember why.",
      "weight": 28
    },
    {
      "id": "nitwit_new_story_bucket",
      "type": "story",
      "text": "I carried an empty bucket all morning. Very light work. Very confusing.",
      "weight": 24
    },
    {
      "id": "nitwit_new_joke_thought",
      "type": "joke",
      "text": "My joke wandered off, but it promised to be funny if it returns.",
      "weight": 18
    },
    {
      "id": "nitwit_new_insult_hat",
      "type": "insult",
      "text": "Your hat looks like it is thinking harder than you.",
      "weight": 18
    },
    {
      "id": "nitwit_new_chat_shadow",
      "type": "chat",
      "text": "I tried following my shadow, but it got behind me somehow.",
      "weight": 28
    },
    {
      "id": "nitwit_new_question_job",
      "type": "question",
      "text": "A job sounds useful. I am saving usefulness for the right moment.",
      "weight": 28
    },
    {
      "id": "nitwit_new_story_bread",
      "type": "story",
      "text": "I once put bread in a chest and called it planning. Nobody argued.",
      "weight": 24
    },
    {
      "id": "nitwit_new_cautious_simple",
      "type": "chat",
      "text": "I can be silly from over here. Over here feels better.",
      "dispositions": [
        "cautious",
        "fearful"
      ],
      "weight": 30
    },
    {
      "id": "nitwit_cured_recognition_warm_1",
      "type": "cured_recognition",
      "text": "I remember you! Mostly. You were the not-scary part of the scary bit.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "nitwit_cured_recognition_warm_2",
      "type": "cured_recognition",
      "text": "You helped me be me again. I am very attached to being me.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "nitwit_cured_recognition_confused_1",
      "type": "cured_recognition",
      "text": "I know your face. Did we meet before or after I stopped groaning?",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "nitwit_cured_recognition_confused_2",
      "type": "cured_recognition",
      "text": "There was an apple, but not the normal apple kind of day.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "nitwit_cured_recognition_uneasy_1",
      "type": "cured_recognition",
      "text": "I remember some of it, and I would like to remember less of it.",
      "weight": 30,
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ]
    },
    {
      "id": "nitwit_village_event_thunderstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "The wandering and hiding places took the thunder badly, but everyone near my station is breathing.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_thunderstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I checked the wandering and hiding places first, then the people. Both needed steady hands.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_thunderstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "That storm rattled the wandering and hiding places; it rattled us more.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_thunderstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "Lightning makes every trade feel small. We are safe enough for now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_thunderstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I will trust the sky again when it stops threatening the roof.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_fire_1",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "I checked the wandering and hiding places for sparks. Then I checked faces for fear.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_fire_2",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Smoke gets into everything: lungs, clothes, and the way people talk afterward.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_fire_3",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "The wandering and hiding places can be replaced. People cannot. That is the count that matters.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_fire_4",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "We saved what hands could reach before the flames decided otherwise.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_fire_5",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Fire teaches quick priorities. Water, exits, children, neighbors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_raid_1",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "During a raid, the wandering and hiding places matters less than who makes it behind a door.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_raid_2",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "The horns stopped, but my hands still expect more trouble.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_raid_3",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "We counted survivors before supplies. That is the right order.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_raid_4",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "Raiders came looking for weakness. They found a village that remembers how to stand.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_raid_5",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "I saw fear move through the village and courage move faster.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_night_attack_1",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Night trouble always finds the loose latch first. We are fixing those now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_night_attack_2",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "I kept near the wandering and hiding places and listened for anyone calling for help.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_night_attack_3",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Dawn did not erase the attack, but it gave us light to count by.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_night_attack_4",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "The dark tested everyone. Most of us passed by staying alive.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "nitwit_village_event_night_attack_5",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "We are safe enough, though every shadow is getting inspected twice.",
      "weight": 34,
      "show_for_babies": false
    }
  ],
  "pacify": [
    {
      "id": "nitwit_pacify_success",
      "outcomes": [
        "success"
      ],
      "text": "Fine. I was getting tired of being angry anyway.",
      "weight": 26
    },
    {
      "id": "nitwit_pacify_short",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "I counted, then forgot, then counted again. It should be {emerald_cost} {emeralds}.",
      "weight": 26
    },
    {
      "id": "nitwit_pacify_blocked",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "No. Even I know this is not fixed.",
      "weight": 26
    }
  ]
}
