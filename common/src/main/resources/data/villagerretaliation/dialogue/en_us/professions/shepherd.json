{
  "messages": [
    {
      "key": "gift_given",
      "text": "Take {gift_item}. A little comfort on the road never hurts.",
      "weight": 24
    },
    {
      "key": "gift_given",
      "text": "Here, {gift_item}. Keep it close when the night gets cold.",
      "weight": 24
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Good. {gift_item} suited {tested_villager} like the right dye on clean wool.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Then the pattern held. {tested_villager} liked {gift_item}.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "Wrong color for that cloth. For {gift_subject}, try {alternative_gift}.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "{gift_item} clashed? Bring {alternative_gift}; softer on the eyes and temper.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "Wrong pattern. Pick up {alternative_gift} and leave {gift_item} out of it.",
      "dispositions": [
        "cautious",
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 20
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "You followed the thread into a knot. Use {alternative_gift} next.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 20
    }
  ],
  "openings": [
    {
      "id": "shepherd_opening",
      "text": "Mind the loom. What do you need?"
    }
  ],
  "closings": [
    {
      "id": "shepherd_closing",
      "text": "Back to turning wool into warmth, then."
    }
  ],
  "lines": [
    {
      "id": "shepherd_chat_flock",
      "type": "chat",
      "text": "Scattered sheep make the whole day longer than it needs to be.",
      "weight": 30
    },
    {
      "id": "shepherd_question_wolves",
      "type": "question",
      "text": "Wolves near the pens change how everyone listens after dark.",
      "weight": 30
    },
    {
      "id": "shepherd_story_wool",
      "type": "story",
      "text": "Clean wool feels ordinary until winter reminds you it is not.",
      "weight": 26
    },
    {
      "id": "shepherd_new_greeting_loom",
      "type": "greeting",
      "text": "Mind the loom. Threads tangle faster when people crowd them.",
      "weight": 26
    },
    {
      "id": "shepherd_new_chat_wool",
      "type": "chat",
      "text": "Clean wool is quiet proof that somebody did the dull work well.",
      "weight": 28
    },
    {
      "id": "shepherd_new_question_warmth",
      "type": "question",
      "text": "Warmth is easy to praise after someone else made it.",
      "weight": 28
    },
    {
      "id": "shepherd_new_story_dye",
      "type": "story",
      "text": "A spilled dye pot once made half the village look festive by mistake.",
      "weight": 24
    },
    {
      "id": "shepherd_new_joke_thread",
      "type": "joke",
      "text": "My jokes have loose threads. Pull gently.",
      "weight": 18
    },
    {
      "id": "shepherd_new_insult_tangle",
      "type": "insult",
      "text": "That thought tangled itself before it reached the loom.",
      "weight": 18
    },
    {
      "id": "shepherd_new_chat_blanket",
      "type": "chat",
      "text": "A good blanket is village peace you can fold.",
      "weight": 28
    },
    {
      "id": "shepherd_new_question_pattern",
      "type": "question",
      "text": "Patterns are easier to see when you stop yanking the thread.",
      "weight": 28
    },
    {
      "id": "shepherd_new_story_late",
      "type": "story",
      "text": "One late evening, the whole loom jammed because I trusted a knot.",
      "weight": 24
    },
    {
      "id": "shepherd_new_rude_work",
      "type": "insult",
      "text": "Do not pull at work you do not understand.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 30
    },
    {
      "id": "shepherd_cured_recognition_warm_1",
      "type": "cured_recognition",
      "text": "I remember being lost from the flock. You brought me back to the fold.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "shepherd_cured_recognition_warm_2",
      "type": "cured_recognition",
      "text": "My thoughts were all tangled wool. You helped card them straight.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "shepherd_cured_recognition_confused_1",
      "type": "cured_recognition",
      "text": "Your face feels familiar, soft in one place and snagged in another.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "shepherd_cured_recognition_confused_2",
      "type": "cured_recognition",
      "text": "I remember shivering, then warmth returning one thread at a time.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "shepherd_cured_recognition_uneasy_1",
      "type": "cured_recognition",
      "text": "I remember you through panic and wool-dark dreams. Keep your voice low.",
      "weight": 30,
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ]
    },
    {
      "id": "shepherd_village_event_thunderstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "The wool and flock took the thunder badly, but everyone near my station is breathing.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_thunderstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I checked the wool and flock first, then the people. Both needed steady hands.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_thunderstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "That storm rattled the wool and flock; it rattled us more.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_thunderstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "Lightning makes every trade feel small. We are safe enough for now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_thunderstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I will trust the sky again when it stops threatening the roof.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_fire_1",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "I checked the wool and flock for sparks. Then I checked faces for fear.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_fire_2",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Smoke gets into everything: lungs, clothes, and the way people talk afterward.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_fire_3",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "The wool and flock can be replaced. People cannot. That is the count that matters.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_fire_4",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "We saved what hands could reach before the flames decided otherwise.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_fire_5",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Fire teaches quick priorities. Water, exits, children, neighbors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_raid_1",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "During a raid, the wool and flock matters less than who makes it behind a door.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_raid_2",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "The horns stopped, but my hands still expect more trouble.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_raid_3",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "We counted survivors before supplies. That is the right order.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_raid_4",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "Raiders came looking for weakness. They found a village that remembers how to stand.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_raid_5",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "I saw fear move through the village and courage move faster.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_night_attack_1",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Night trouble always finds the loose latch first. We are fixing those now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_night_attack_2",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "I kept near the wool and flock and listened for anyone calling for help.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_night_attack_3",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Dawn did not erase the attack, but it gave us light to count by.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_night_attack_4",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "The dark tested everyone. Most of us passed by staying alive.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_night_attack_5",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "We are safe enough, though every shadow is getting inspected twice.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_sandstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "The wool and flock collected half the desert, but the people made it indoors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_sandstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "I checked the wool and flock, then checked who was coughing from the dust.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_sandstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Sand in the hinges, sand in the eyes, but no one missing so far.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_sandstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Harsh wind teaches you which doors really close.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_sandstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "We are safe enough, though the village sounds like it is grinding its teeth.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_snowstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The wool and flock can wait. Warm hands and clear paths matter first.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_snowstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Snow piled against the doors, but everyone near me found shelter.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_snowstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Cold works quietly. We are checking on anyone who went quiet too long.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_snowstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The wool and flock froze stiff, but the village kept moving.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "shepherd_village_event_snowstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "We are alright for now. Keep the fires fed and the paths open.",
      "weight": 34,
      "show_for_babies": false
    }
  ],
  "pacify": [
    {
      "id": "shepherd_pacify_success",
      "outcomes": [
        "success"
      ],
      "text": "Fine. I will smooth this wool down for now.",
      "weight": 26
    },
    {
      "id": "shepherd_pacify_short",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "That does not cover the tear. Bring {emerald_cost} {emeralds}.",
      "weight": 26
    },
    {
      "id": "shepherd_pacify_blocked",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "No. The flock still startles when you come near.",
      "weight": 26
    }
  ]
}
