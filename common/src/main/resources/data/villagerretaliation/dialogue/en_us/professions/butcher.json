{
  "messages": [
    {
      "key": "gift_given",
      "text": "Take {gift_item}. A good village keeps its friends fed and standing.",
      "weight": 24
    },
    {
      "key": "gift_given",
      "text": "Here, {gift_item}. It is honest work to send someone off with provisions.",
      "weight": 24
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Good. {tested_villager} has a sound nose for {gift_item}. Fresh advice, clean cut.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "If {tested_villager} liked {gift_item}, then the cut was right.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "Bad cut, then. For {gift_subject}, I would set down {gift_item} and bring {alternative_gift}.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "Some gifts spoil in the telling. Try {alternative_gift}; that should suit {gift_subject} better.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "You got a tough cut of advice. Next time, bring {alternative_gift}.",
      "dispositions": [
        "cautious",
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 20
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "{gift_item} went over badly? Then trim your losses and try {alternative_gift}.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 20
    }
  ],
  "openings": [
    {
      "id": "butcher_opening",
      "text": "Mind the smokehouse. What do you need?"
    }
  ],
  "closings": [
    {
      "id": "butcher_closing",
      "text": "Back to keeping meat salted and safe, then."
    }
  ],
  "lines": [
    {
      "id": "butcher_chat_work",
      "type": "chat",
      "text": "A smokehouse tells you fast who understands patience.",
      "weight": 30
    },
    {
      "id": "butcher_question_supplies",
      "type": "question",
      "text": "Empty hooks before supper can frighten a village more than thunder.",
      "weight": 30
    },
    {
      "id": "butcher_story_stores",
      "type": "story",
      "text": "Food decides whether a scare becomes a disaster.",
      "weight": 26
    },
    {
      "id": "butcher_new_greeting_smoke",
      "type": "greeting",
      "text": "If you smell smoke, that is supper being planned properly.",
      "weight": 26
    },
    {
      "id": "butcher_new_chat_salt",
      "type": "chat",
      "text": "Salt is patient. That is why it keeps food better than most people keep promises.",
      "weight": 28
    },
    {
      "id": "butcher_new_question_hooks",
      "type": "question",
      "text": "Empty hooks tell a village to start worrying before anyone says it aloud.",
      "weight": 28
    },
    {
      "id": "butcher_new_story_cellar",
      "type": "story",
      "text": "A full cellar has ended more arguments here than any speech ever did.",
      "weight": 24
    },
    {
      "id": "butcher_new_joke_cuts",
      "type": "joke",
      "text": "My jokes are like my cuts: better when nobody rushes me.",
      "weight": 18
    },
    {
      "id": "butcher_new_insult_stale",
      "type": "insult",
      "text": "That was stale enough to leave on the shelf.",
      "weight": 18
    },
    {
      "id": "butcher_new_chat_supper",
      "type": "chat",
      "text": "People think about courage until supper is late. Then they think about supper.",
      "weight": 28
    },
    {
      "id": "butcher_new_question_store",
      "type": "question",
      "text": "A village with good stores can make careful choices instead of desperate ones.",
      "weight": 28
    },
    {
      "id": "butcher_new_story_smokehouse",
      "type": "story",
      "text": "Once the smokehouse door stuck shut, and everyone became helpful very quickly.",
      "weight": 24
    },
    {
      "id": "butcher_new_rude_manners",
      "type": "insult",
      "text": "I have carved gristle with more grace than you brought here.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 30
    },
    {
      "id": "butcher_cured_recognition_warm_1",
      "type": "cured_recognition",
      "text": "I remember hunger without a name. You brought me back before it swallowed everything.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "butcher_cured_recognition_warm_2",
      "type": "cured_recognition",
      "text": "The cure left me shaking, but alive. That counts for more than a full smokehouse.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "butcher_cured_recognition_confused_1",
      "type": "cured_recognition",
      "text": "Your face stirs something. Not appetite. Memory, I hope.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "butcher_cured_recognition_confused_2",
      "type": "cured_recognition",
      "text": "I remember a sour potion, an apple, and trying not to bite the hand near me.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "butcher_cured_recognition_uneasy_1",
      "type": "cured_recognition",
      "text": "I remember enough to be grateful, and enough to be ashamed. Give me room.",
      "weight": 30,
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ]
    },
    {
      "id": "butcher_village_event_thunderstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "The smokehouse and knives took the thunder badly, but everyone near my station is breathing.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_thunderstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I checked the smokehouse and knives first, then the people. Both needed steady hands.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_thunderstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "That storm rattled the smokehouse and knives; it rattled us more.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_thunderstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "Lightning makes every trade feel small. We are safe enough for now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_thunderstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I will trust the sky again when it stops threatening the roof.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_fire_1",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "I checked the smokehouse and knives for sparks. Then I checked faces for fear.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_fire_2",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Smoke gets into everything: lungs, clothes, and the way people talk afterward.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_fire_3",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "The smokehouse and knives can be replaced. People cannot. That is the count that matters.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_fire_4",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "We saved what hands could reach before the flames decided otherwise.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_fire_5",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Fire teaches quick priorities. Water, exits, children, neighbors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_raid_1",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "During a raid, the smokehouse and knives matters less than who makes it behind a door.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_raid_2",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "The horns stopped, but my hands still expect more trouble.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_raid_3",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "We counted survivors before supplies. That is the right order.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_raid_4",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "Raiders came looking for weakness. They found a village that remembers how to stand.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_raid_5",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "I saw fear move through the village and courage move faster.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_night_attack_1",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Night trouble always finds the loose latch first. We are fixing those now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_night_attack_2",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "I kept near the smokehouse and knives and listened for anyone calling for help.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_night_attack_3",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Dawn did not erase the attack, but it gave us light to count by.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_night_attack_4",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "The dark tested everyone. Most of us passed by staying alive.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_night_attack_5",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "We are safe enough, though every shadow is getting inspected twice.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_sandstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "The smokehouse and knives collected half the desert, but the people made it indoors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_sandstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "I checked the smokehouse and knives, then checked who was coughing from the dust.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_sandstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Sand in the hinges, sand in the eyes, but no one missing so far.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_sandstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Harsh wind teaches you which doors really close.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_sandstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "We are safe enough, though the village sounds like it is grinding its teeth.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_snowstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The smokehouse and knives can wait. Warm hands and clear paths matter first.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_snowstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Snow piled against the doors, but everyone near me found shelter.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_snowstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Cold works quietly. We are checking on anyone who went quiet too long.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_snowstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The smokehouse and knives froze stiff, but the village kept moving.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_village_event_snowstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "We are alright for now. Keep the fires fed and the paths open.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "butcher_share_story_1",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "{target_article}? Then keep your stores tight. Fear makes people careless with food and doors.",
      "weight": 24
    },
    {
      "id": "butcher_share_story_2",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "You brought back a story from {target}. Good. Bad places are worse when no one names them.",
      "weight": 24
    },
    {
      "id": "butcher_share_story_3",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "I know the smell of danger well enough. {target} sounds like a place to leave before dusk.",
      "weight": 24
    },
    {
      "id": "butcher_share_story_4",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "If travelers are drifting from {target_article}, we will need knives sharp and soup ready.",
      "weight": 24
    },
    {
      "id": "butcher_share_story_5",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "Some stories spoil if ignored. I will pass word about {target}.",
      "weight": 24
    }
  ],
  "pacify": [
    {
      "id": "butcher_pacify_success",
      "outcomes": [
        "success"
      ],
      "text": "Fine. I have work to get back to, and anger spoils the day.",
      "weight": 26
    },
    {
      "id": "butcher_pacify_short",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "Too lean an offer. Bring {emerald_cost} {emeralds} if you want this cut clean.",
      "weight": 26
    },
    {
      "id": "butcher_pacify_blocked",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "No. I know bad meat, and I know bad apologies.",
      "weight": 26
    }
  ]
}
