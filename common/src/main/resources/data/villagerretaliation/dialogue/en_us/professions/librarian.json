{
  "messages": [
    {
      "key": "gift_given",
      "text": "Take {gift_item}. Knowledge is not the only thing worth lending carefully.",
      "weight": 24
    },
    {
      "key": "gift_given",
      "text": "Here, {gift_item}. Return with a story, and I will call it a fair trade.",
      "weight": 24
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Excellent. I will mark {gift_item} as a good recommendation, then.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Then my reference was sound. {gift_item} belongs on that page.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "An error in the margin, then. For {gift_subject}, revise the gift to {alternative_gift}.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "{gift_item} was the wrong citation. Try {alternative_gift}; much stronger source.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "Then consider that note corrected. For {gift_subject}, write down {alternative_gift}.",
      "dispositions": [
        "cautious",
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 20
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "You accepted a poor source without checking it. Next source: {alternative_gift}.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 20
    }
  ],
  "openings": [
    {
      "id": "librarian_opening",
      "text": "Mind the lectern. What do you need?"
    }
  ],
  "closings": [
    {
      "id": "librarian_closing",
      "text": "Back to keeping records and stories straight, then."
    }
  ],
  "lines": [
    {
      "id": "librarian_chat_pages",
      "type": "chat",
      "text": "Missing pages worry me less than people who never read warnings.",
      "weight": 30
    },
    {
      "id": "librarian_question_memory",
      "type": "question",
      "text": "Villages remember more than people expect.",
      "weight": 30
    },
    {
      "id": "librarian_story_records",
      "type": "story",
      "text": "Every trade, every kindness, every cruelty. Someone writes it down.",
      "weight": 26
    },
    {
      "id": "librarian_new_greeting_lectern",
      "type": "greeting",
      "text": "Mind the lectern. It has heard better questions than most people ask.",
      "weight": 26
    },
    {
      "id": "librarian_new_chat_ink",
      "type": "chat",
      "text": "Ink is quiet until someone needs proof.",
      "weight": 28
    },
    {
      "id": "librarian_new_question_record",
      "type": "question",
      "text": "Records do not care who feels embarrassed by them.",
      "weight": 28
    },
    {
      "id": "librarian_new_story_margin",
      "type": "story",
      "text": "The best clue I ever found was written in a margin by someone annoyed.",
      "weight": 24
    },
    {
      "id": "librarian_new_joke_footnote",
      "type": "joke",
      "text": "I had a footnote for this joke, but mercy won.",
      "weight": 18
    },
    {
      "id": "librarian_new_insult_blank",
      "type": "insult",
      "text": "That thought had too many blank pages.",
      "weight": 18
    },
    {
      "id": "librarian_new_chat_shelf",
      "type": "chat",
      "text": "A tidy shelf is proof that peace can be arranged, briefly.",
      "weight": 28
    },
    {
      "id": "librarian_new_question_warning",
      "type": "question",
      "text": "Forgotten warnings do not become kinder. They become surprises.",
      "weight": 28
    },
    {
      "id": "librarian_new_story_borrowed",
      "type": "story",
      "text": "Someone once returned a book cleaner than they borrowed it. We still discuss it.",
      "weight": 24
    },
    {
      "id": "librarian_new_hostile_memory",
      "type": "chat",
      "text": "You may prefer I forget. I have chosen a profession that argues otherwise.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 30
    },
    {
      "id": "librarian_cured_recognition_warm_1",
      "type": "cured_recognition",
      "text": "I remember the page turning back from a very bad ending.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "librarian_cured_recognition_warm_2",
      "type": "cured_recognition",
      "text": "Your face is one of the first words I could read again.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "librarian_cured_recognition_confused_1",
      "type": "cured_recognition",
      "text": "The chapter is damaged, but your name survived in the margin.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "librarian_cured_recognition_confused_2",
      "type": "cured_recognition",
      "text": "I remember fragments: weakness, gold, a bitter draught, and you waiting.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "librarian_cured_recognition_uneasy_1",
      "type": "cured_recognition",
      "text": "I remember you. Some books should be opened slowly after a curse.",
      "weight": 30,
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ]
    },
    {
      "id": "librarian_village_event_thunderstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "The records and shelves took the thunder badly, but everyone near my station is breathing.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_thunderstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I checked the records and shelves first, then the people. Both needed steady hands.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_thunderstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "That storm rattled the records and shelves; it rattled us more.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_thunderstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "Lightning makes every trade feel small. We are safe enough for now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_thunderstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I will trust the sky again when it stops threatening the roof.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_fire_1",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "I checked the records and shelves for sparks. Then I checked faces for fear.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_fire_2",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Smoke gets into everything: lungs, clothes, and the way people talk afterward.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_fire_3",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "The records and shelves can be replaced. People cannot. That is the count that matters.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_fire_4",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "We saved what hands could reach before the flames decided otherwise.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_fire_5",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Fire teaches quick priorities. Water, exits, children, neighbors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_raid_1",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "During a raid, the records and shelves matters less than who makes it behind a door.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_raid_2",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "The horns stopped, but my hands still expect more trouble.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_raid_3",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "We counted survivors before supplies. That is the right order.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_raid_4",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "Raiders came looking for weakness. They found a village that remembers how to stand.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_raid_5",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "I saw fear move through the village and courage move faster.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_night_attack_1",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Night trouble always finds the loose latch first. We are fixing those now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_night_attack_2",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "I kept near the records and shelves and listened for anyone calling for help.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_night_attack_3",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Dawn did not erase the attack, but it gave us light to count by.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_night_attack_4",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "The dark tested everyone. Most of us passed by staying alive.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_night_attack_5",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "We are safe enough, though every shadow is getting inspected twice.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_sandstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "The records and shelves collected half the desert, but the people made it indoors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_sandstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "I checked the records and shelves, then checked who was coughing from the dust.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_sandstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Sand in the hinges, sand in the eyes, but no one missing so far.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_sandstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Harsh wind teaches you which doors really close.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_sandstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "We are safe enough, though the village sounds like it is grinding its teeth.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_snowstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The records and shelves can wait. Warm hands and clear paths matter first.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_snowstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Snow piled against the doors, but everyone near me found shelter.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_snowstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Cold works quietly. We are checking on anyone who went quiet too long.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_snowstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The records and shelves froze stiff, but the village kept moving.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "librarian_village_event_snowstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "We are alright for now. Keep the fires fed and the paths open.",
      "weight": 34,
      "show_for_babies": false
    }
  ],
  "pacify": [
    {
      "id": "librarian_pacify_success",
      "outcomes": [
        "success"
      ],
      "text": "Fine. I will close this chapter, but I am not tearing out the page.",
      "weight": 26
    },
    {
      "id": "librarian_pacify_short",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "The account is incomplete. It requires {emerald_cost} {emeralds}.",
      "weight": 26
    },
    {
      "id": "librarian_pacify_blocked",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "No. The record is too fresh, and not in your favor.",
      "weight": 26
    }
  ]
}
