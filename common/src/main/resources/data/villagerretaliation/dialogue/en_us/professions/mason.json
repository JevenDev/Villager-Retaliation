{
  "messages": [
    {
      "key": "gift_given",
      "text": "Here, {gift_item}. Strong villages are built one fair exchange at a time.",
      "weight": 24
    },
    {
      "key": "gift_given",
      "text": "Take {gift_item}. A steady hand deserves steady thanks.",
      "weight": 24
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Good. {gift_item} sat square with {tested_villager}.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.liked",
      "text": "Then the advice was level. {tested_villager} liked {gift_item}.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "That foundation cracked. For {gift_subject}, set {alternative_gift} instead.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "{gift_item} did not bear weight there? Try {alternative_gift}; sturdier choice.",
      "weight": 22
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "That advice cracked under pressure. Set {alternative_gift} in its place.",
      "dispositions": [
        "cautious",
        "rude",
        "hostile",
        "fearful"
      ],
      "weight": 20
    },
    {
      "key": "gift_advice_followup.disliked",
      "text": "You built on weak stone. Use {alternative_gift} if you want it to stand.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 20
    }
  ],
  "openings": [
    {
      "id": "mason_opening",
      "text": "Mind the stonecutter. What do you need?"
    }
  ],
  "closings": [
    {
      "id": "mason_closing",
      "text": "Back to setting stone that stays set, then."
    }
  ],
  "lines": [
    {
      "id": "mason_chat_corners",
      "type": "chat",
      "text": "Walls with weak corners teach humility before they teach repair.",
      "weight": 30
    },
    {
      "id": "mason_question_stone",
      "type": "question",
      "text": "Stone remembers pressure. People do too.",
      "weight": 30
    },
    {
      "id": "mason_story_wall",
      "type": "story",
      "text": "The best wall is boring. Boring means it held.",
      "weight": 26
    },
    {
      "id": "mason_new_greeting_stonecutter",
      "type": "greeting",
      "text": "Keep clear of the stonecutter. It does not care who started the conversation.",
      "weight": 26
    },
    {
      "id": "mason_new_chat_wall",
      "type": "chat",
      "text": "A wall is only as honest as its weakest corner.",
      "weight": 28
    },
    {
      "id": "mason_new_question_foundation",
      "type": "question",
      "text": "Foundations matter because everything else gets to pretend they do not.",
      "weight": 28
    },
    {
      "id": "mason_new_story_chip",
      "type": "story",
      "text": "One bad chip once made me redo a whole doorway. It was right to complain.",
      "weight": 24
    },
    {
      "id": "mason_new_joke_dense",
      "type": "joke",
      "text": "Mason jokes are solid. Sometimes too solid to move.",
      "weight": 18
    },
    {
      "id": "mason_new_insult_gravel",
      "type": "insult",
      "text": "That remark had all the strength of loose gravel.",
      "weight": 18
    },
    {
      "id": "mason_new_chat_steps",
      "type": "chat",
      "text": "Good steps are noticed only by people who have climbed bad ones.",
      "weight": 28
    },
    {
      "id": "mason_new_question_crack",
      "type": "question",
      "text": "A crack is not always disaster. Sometimes it is a warning asking politely.",
      "weight": 28
    },
    {
      "id": "mason_new_story_arch",
      "type": "story",
      "text": "An arch looks impossible until the last stone proves everyone wrong.",
      "weight": 24
    },
    {
      "id": "mason_new_rude_weight",
      "type": "insult",
      "text": "Your words carry weight, but not the useful kind.",
      "dispositions": [
        "rude",
        "hostile"
      ],
      "weight": 30
    },
    {
      "id": "mason_cured_recognition_warm_1",
      "type": "cured_recognition",
      "text": "I remember being rubble. You helped set the first stone back in place.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "mason_cured_recognition_warm_2",
      "type": "cured_recognition",
      "text": "The cure cracked the old dark apart. You were there when the wall held.",
      "weight": 30,
      "dispositions": [
        "friendly",
        "respectful"
      ]
    },
    {
      "id": "mason_cured_recognition_confused_1",
      "type": "cured_recognition",
      "text": "Your face is carved into that memory, but weather has worn it strange.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "mason_cured_recognition_confused_2",
      "type": "cured_recognition",
      "text": "I remember stone-cold hands, a golden taste, and standing upright again.",
      "weight": 30,
      "dispositions": [
        "neutral",
        "cautious"
      ]
    },
    {
      "id": "mason_cured_recognition_uneasy_1",
      "type": "cured_recognition",
      "text": "I remember you from beneath a collapsed roof of thoughts. Speak gently.",
      "weight": 30,
      "dispositions": [
        "rude",
        "hostile",
        "fearful"
      ]
    },
    {
      "id": "mason_village_event_thunderstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "The stone and walls took the thunder badly, but everyone near my station is breathing.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_thunderstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I checked the stone and walls first, then the people. Both needed steady hands.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_thunderstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "That storm rattled the stone and walls; it rattled us more.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_thunderstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "Lightning makes every trade feel small. We are safe enough for now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_thunderstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "thunderstorm"
      ],
      "text": "I will trust the sky again when it stops threatening the roof.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_fire_1",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "I checked the stone and walls for sparks. Then I checked faces for fear.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_fire_2",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Smoke gets into everything: lungs, clothes, and the way people talk afterward.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_fire_3",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "The stone and walls can be replaced. People cannot. That is the count that matters.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_fire_4",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "We saved what hands could reach before the flames decided otherwise.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_fire_5",
      "type": "village_event_report",
      "event_tags": [
        "village_fire"
      ],
      "text": "Fire teaches quick priorities. Water, exits, children, neighbors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_raid_1",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "During a raid, the stone and walls matters less than who makes it behind a door.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_raid_2",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "The horns stopped, but my hands still expect more trouble.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_raid_3",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "We counted survivors before supplies. That is the right order.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_raid_4",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "Raiders came looking for weakness. They found a village that remembers how to stand.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_raid_5",
      "type": "village_event_report",
      "event_tags": [
        "raid",
        "player_defended_raid"
      ],
      "text": "I saw fear move through the village and courage move faster.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_night_attack_1",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Night trouble always finds the loose latch first. We are fixing those now.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_night_attack_2",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "I kept near the stone and walls and listened for anyone calling for help.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_night_attack_3",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "Dawn did not erase the attack, but it gave us light to count by.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_night_attack_4",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "The dark tested everyone. Most of us passed by staying alive.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_night_attack_5",
      "type": "village_event_report",
      "event_tags": [
        "night_attack"
      ],
      "text": "We are safe enough, though every shadow is getting inspected twice.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_sandstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "The stone and walls collected half the desert, but the people made it indoors.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_sandstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "I checked the stone and walls, then checked who was coughing from the dust.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_sandstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Sand in the hinges, sand in the eyes, but no one missing so far.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_sandstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "Harsh wind teaches you which doors really close.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_sandstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "sandstorm"
      ],
      "text": "We are safe enough, though the village sounds like it is grinding its teeth.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_snowstorm_1",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The stone and walls can wait. Warm hands and clear paths matter first.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_snowstorm_2",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Snow piled against the doors, but everyone near me found shelter.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_snowstorm_3",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "Cold works quietly. We are checking on anyone who went quiet too long.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_snowstorm_4",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "The stone and walls froze stiff, but the village kept moving.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_village_event_snowstorm_5",
      "type": "village_event_report",
      "event_tags": [
        "snowstorm"
      ],
      "text": "We are alright for now. Keep the fires fed and the paths open.",
      "weight": 34,
      "show_for_babies": false
    },
    {
      "id": "mason_share_story_1",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "{target_article}. Stone can remember cruelty longer than people do.",
      "weight": 24
    },
    {
      "id": "mason_share_story_2",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "If {target} still stands, stand away from it when you can.",
      "weight": 24
    },
    {
      "id": "mason_share_story_3",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "I trust walls that shelter. I do not trust the kind around {target_article}.",
      "weight": 24
    },
    {
      "id": "mason_share_story_4",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "Good foundations hold homes. Bad ones hold stories like {target}.",
      "weight": 24
    },
    {
      "id": "mason_share_story_5",
      "type": "share_story",
      "option": "adult_share_story",
      "text": "I will warn the road crews. No one should quarry courage near {target_article}.",
      "weight": 24
    }
  ],
  "pacify": [
    {
      "id": "mason_pacify_success",
      "outcomes": [
        "success"
      ],
      "text": "Fine. I will set this stone down carefully.",
      "weight": 26
    },
    {
      "id": "mason_pacify_short",
      "outcomes": [
        "not_enough_emeralds"
      ],
      "text": "That foundation will not hold. Bring {emerald_cost} {emeralds}.",
      "weight": 26
    },
    {
      "id": "mason_pacify_blocked",
      "outcomes": [
        "blocked_by_reputation"
      ],
      "text": "No. Some cracks keep spreading after the offer is made.",
      "weight": 26
    }
  ]
}
