{
  "type": "object",
  "title": "Persistent cinematic scene v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jeven.dev/villager-retaliation/schema/scene-v1.schema.json",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "ownership",
    "entry_step",
    "actors",
    "steps"
  ],
  "properties": {
    "schema": {
      "const": "villagerretaliation:scene/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "definition_version": {
      "type": "integer",
      "minimum": 1
    },
    "ownership": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "player",
        "party",
        "quest_instance",
        "world"
      ]
    },
    "entry_step": {
      "type": "string",
      "minLength": 1
    },
    "timeout_ticks": {
      "type": "integer",
      "minimum": 0
    },
    "failure_policy": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "fail_scene",
        "cancel_scene",
        "block_for_repair",
        "run_failure_step"
      ]
    },
    "cancellation_policy": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "fail_scene",
        "cancel_scene",
        "block_for_repair",
        "run_failure_step"
      ]
    },
    "cleanup_policy": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "none",
        "owned_entities",
        "encounters",
        "all_owned",
        "preserve_world"
      ]
    },
    "metadata": {
      "type": "object",
      "title": "Data",
      "additionalProperties": true
    },
    "actors": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "title": "Actor declaration",
        "additionalProperties": false,
        "required": [
          "alias",
          "type"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
            "enum": [
              "villagerretaliation:hostile_encounter_group",
              "villagerretaliation:living_entity",
              "villagerretaliation:player",
              "villagerretaliation:position",
              "villagerretaliation:villager"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "capabilities": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            }
          },
          "binding_source": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "owner_player",
              "party_member",
              "quest_provider",
              "uuid",
              "marker",
              "entity_tag",
              "campaign_location",
              "campaign_role",
              "encounter",
              "owned_spawn",
              "unbound"
            ]
          },
          "binding": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "replacement_policy": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "fixed",
              "operator_rebindable",
              "compatible_replacement",
              "respawn_if_owned",
              "optional"
            ]
          },
          "missing_actor_policy": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "block",
              "fail",
              "skip",
              "wait_until_timeout"
            ]
          },
          "lethal_damage_policy": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "normal",
              "downed"
            ]
          },
          "death_policy": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "fail",
              "block",
              "apply_missing_policy",
              "respawn_if_owned",
              "continue_with_snapshot"
            ]
          },
          "filters": {
            "type": "object",
            "title": "Data",
            "additionalProperties": true
          },
          "timeout_ticks": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "title": "Stable scene step",
        "additionalProperties": false,
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
            "enum": [
              "villagerretaliation:action_batch",
              "villagerretaliation:cancel_encounter",
              "villagerretaliation:cleanup_encounter",
              "villagerretaliation:dialogue",
              "villagerretaliation:face_actor",
              "villagerretaliation:face_position",
              "villagerretaliation:follow_actor",
              "villagerretaliation:move_actor",
              "villagerretaliation:quest_transition",
              "villagerretaliation:scene_branch",
              "villagerretaliation:scene_complete",
              "villagerretaliation:scene_fail",
              "villagerretaliation:start_encounter",
              "villagerretaliation:wait_condition",
              "villagerretaliation:wait_encounter",
              "villagerretaliation:wait_ticks"
            ]
          },
          "actors": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
            }
          },
          "data": {
            "type": "object",
            "title": "Data",
            "additionalProperties": true,
            "allOf": [
              {
                "$ref": "#/$defs/campaign_transaction_fields"
              },
              {
                "$ref": "#/$defs/campaign_evidence_fields"
              },
              {
                "$ref": "#/$defs/campaign_companion_fields"
              }
            ],
            "properties": {
              "exchanges": {
                "type": "array",
                "minItems": 1,
                "maxItems": 64,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "speaker",
                    "text"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "speaker": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "type"
                      ],
                      "properties": {
                        "type": {
                          "enum": [
                            "role",
                            "player",
                            "narrator"
                          ]
                        },
                        "role": {
                          "const": "provider"
                        }
                      },
                      "if": {
                        "properties": {
                          "type": {
                            "const": "role"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "role"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "role"
                          ]
                        }
                      }
                    },
                    "text": {
                      "oneOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 512
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "key"
                          ],
                          "properties": {
                            "key": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 256
                            }
                          }
                        }
                      ]
                    },
                    "text_key": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    },
                    "camera": {
                      "oneOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "target"
                          ],
                          "properties": {
                            "target": {
                              "enum": [
                                "speaker",
                                "character",
                                "none"
                              ]
                            },
                            "zoom": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 0.45
                            }
                          },
                          "if": {
                            "properties": {
                              "target": {
                                "const": "none"
                              }
                            }
                          },
                          "then": {
                            "not": {
                              "required": [
                                "zoom"
                              ]
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "preset"
                          ],
                          "properties": {
                            "preset": {
                              "enum": [
                                "first_person",
                                "third_person",
                                "over_shoulder_left",
                                "over_shoulder_right",
                                "birds_eye",
                                "behind",
                                "telescope",
                                "speaker_facing",
                                "custom"
                              ]
                            },
                            "anchor": {
                              "enum": [
                                "player",
                                "speaker"
                              ]
                            },
                            "placement": {
                              "enum": [
                                "relative",
                                "fixed"
                              ]
                            },
                            "perspective": {
                              "enum": [
                                "first_person",
                                "third_person"
                              ]
                            },
                            "offset": {
                              "type": "array",
                              "minItems": 3,
                              "maxItems": 3,
                              "items": {
                                "type": "number",
                                "minimum": -8,
                                "maximum": 8
                              }
                            },
                            "target": {
                              "enum": [
                                "speaker",
                                "character",
                                "group"
                              ]
                            },
                            "fov": {
                              "type": "number",
                              "minimum": 10,
                              "maximum": 110
                            },
                            "hold_seconds": {
                              "type": "number",
                              "minimum": 0,
                              "maximum": 600
                            },
                            "transition": {
                              "oneOf": [
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "type"
                                  ],
                                  "properties": {
                                    "type": {
                                      "const": "cut"
                                    }
                                  }
                                },
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "required": [
                                    "type",
                                    "duration_seconds"
                                  ],
                                  "properties": {
                                    "type": {
                                      "const": "lerp"
                                    },
                                    "duration_seconds": {
                                      "type": "number",
                                      "minimum": 0.001,
                                      "maximum": 600
                                    },
                                    "easing": {
                                      "enum": [
                                        "linear",
                                        "smoothstep"
                                      ]
                                    }
                                  }
                                }
                              ]
                            }
                          },
                          "if": {
                            "properties": {
                              "preset": {
                                "const": "custom"
                              }
                            }
                          },
                          "then": {
                            "required": [
                              "anchor",
                              "offset",
                              "perspective"
                            ]
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "shots"
                          ],
                          "properties": {
                            "shots": {
                              "type": "array",
                              "minItems": 1,
                              "maxItems": 32,
                              "items": {
                                "type": "object",
                                "additionalProperties": false,
                                "required": [
                                  "preset"
                                ],
                                "properties": {
                                  "preset": {
                                    "enum": [
                                      "first_person",
                                      "third_person",
                                      "over_shoulder_left",
                                      "over_shoulder_right",
                                      "birds_eye",
                                      "behind",
                                      "telescope",
                                      "speaker_facing",
                                      "custom"
                                    ]
                                  },
                                  "anchor": {
                                    "enum": [
                                      "player",
                                      "speaker"
                                    ]
                                  },
                                  "placement": {
                                    "enum": [
                                      "relative",
                                      "fixed"
                                    ]
                                  },
                                  "perspective": {
                                    "enum": [
                                      "first_person",
                                      "third_person"
                                    ]
                                  },
                                  "offset": {
                                    "type": "array",
                                    "minItems": 3,
                                    "maxItems": 3,
                                    "items": {
                                      "type": "number",
                                      "minimum": -8,
                                      "maximum": 8
                                    }
                                  },
                                  "target": {
                                    "enum": [
                                      "speaker",
                                      "character",
                                      "group"
                                    ]
                                  },
                                  "fov": {
                                    "type": "number",
                                    "minimum": 10,
                                    "maximum": 110
                                  },
                                  "hold_seconds": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 600
                                  },
                                  "transition": {
                                    "oneOf": [
                                      {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": [
                                          "type"
                                        ],
                                        "properties": {
                                          "type": {
                                            "const": "cut"
                                          }
                                        }
                                      },
                                      {
                                        "type": "object",
                                        "additionalProperties": false,
                                        "required": [
                                          "type",
                                          "duration_seconds"
                                        ],
                                        "properties": {
                                          "type": {
                                            "const": "lerp"
                                          },
                                          "duration_seconds": {
                                            "type": "number",
                                            "minimum": 0.001,
                                            "maximum": 600
                                          },
                                          "easing": {
                                            "enum": [
                                              "linear",
                                              "smoothstep"
                                            ]
                                          }
                                        }
                                      }
                                    ]
                                  }
                                },
                                "if": {
                                  "properties": {
                                    "preset": {
                                      "const": "custom"
                                    }
                                  }
                                },
                                "then": {
                                  "required": [
                                    "anchor",
                                    "offset",
                                    "perspective"
                                  ]
                                }
                              }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "next": {
            "type": "string",
            "minLength": 1
          },
          "failure_step": {
            "type": "string",
            "minLength": 1
          },
          "transitions": {
            "type": "object",
            "title": "Data",
            "additionalProperties": true
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "villagerretaliation:quest_transition"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "data": {
                  "type": "object",
                  "title": "Typed quest transition",
                  "additionalProperties": false,
                  "properties": {
                    "quest": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                    },
                    "quest_id": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                    },
                    "target": {
                      "type": "string",
                      "minLength": 1,
                      "enum": [
                        "stage",
                        "complete",
                        "fail",
                        "abandon"
                      ]
                    },
                    "target_stage": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
                    }
                  },
                  "oneOf": [
                    {
                      "required": [
                        "quest"
                      ]
                    },
                    {
                      "required": [
                        "quest_id"
                      ]
                    }
                  ],
                  "allOf": [
                    {
                      "oneOf": [
                        {
                          "required": [
                            "target_stage"
                          ],
                          "properties": {
                            "target": {
                              "enum": [
                                "stage"
                              ]
                            }
                          }
                        },
                        {
                          "required": [
                            "target"
                          ],
                          "properties": {
                            "target": {
                              "enum": [
                                "complete",
                                "fail",
                                "abandon"
                              ]
                            }
                          },
                          "not": {
                            "required": [
                              "target_stage"
                            ]
                          }
                        }
                      ]
                    }
                  ]
                }
              },
              "required": [
                "data"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "villagerretaliation:follow_actor"
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "properties": {
                "data": {
                  "additionalProperties": false,
                  "properties": {
                    "actor": {
                      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
                      "type": "string"
                    },
                    "target_actor": {
                      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
                      "type": "string"
                    },
                    "follow_distance": {
                      "maximum": 32.0,
                      "minimum": 2.0,
                      "type": "number"
                    },
                    "arrival_distance": {
                      "maximum": 4.0,
                      "minimum": 0.25,
                      "type": "number"
                    },
                    "speed": {
                      "maximum": 1.0,
                      "minimum": 0.05,
                      "type": "number"
                    },
                    "poll_ticks": {
                      "maximum": 5.0,
                      "minimum": 1.0,
                      "type": "integer"
                    },
                    "timeout_ticks": {
                      "maximum": 72000.0,
                      "minimum": 1.0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "actor",
                    "target_actor"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "data"
              ]
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "localized_reference": {
      "type": "object",
      "title": "Localized message reference",
      "additionalProperties": false,
      "required": [
        "key"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "campaign_evidence_fields": {
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "additionalProperties": {
              "$ref": "#/$defs/campaign_evidence_fields"
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "type": "string",
                      "pattern": "^[\\x00-\\x20]*[cC][aA][mM][pP][aA][iI][gG][nN]_[eE][vV][iI][dD][eE][nN][cC][eE][\\x00-\\x20]*$"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "campaign_evidence"
                    },
                    "campaign": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$(?![\\s\\S])"
                    },
                    "evidence": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[a-z0-9][a-z0-9_./-]{0,255}$(?![\\s\\S])"
                    }
                  },
                  "required": [
                    "campaign",
                    "evidence"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "type": "array"
          },
          "then": {
            "items": {
              "$ref": "#/$defs/campaign_evidence_fields"
            }
          }
        }
      ]
    },
    "campaign_transaction_fields": {
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "additionalProperties": {
              "$ref": "#/$defs/campaign_transaction_fields"
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "type": {
                      "type": "string",
                      "pattern": "^[\\x00-\\x20]*[cC][aA][mM][pP][aA][iI][gG][nN]_[pP][aA][yY][mM][eE][nN][tT][\\x00-\\x20]*$"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "type": "object",
                  "properties": {
                    "transaction": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[a-z0-9][a-z0-9_./-]{0,255}$"
                    },
                    "required": {
                      "const": true
                    },
                    "quest": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                    },
                    "quest_id": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                    }
                  },
                  "required": [
                    "transaction"
                  ],
                  "anyOf": [
                    {
                      "required": [
                        "quest"
                      ]
                    },
                    {
                      "required": [
                        "quest_id"
                      ]
                    }
                  ]
                }
              },
              {
                "if": {
                  "properties": {
                    "type": {
                      "type": "string",
                      "pattern": "^[\\x00-\\x20]*[cC][aA][mM][pP][aA][iI][gG][nN]_[tT][rR][aA][nN][sS][aA][cC][tT][iI][oO][nN][\\x00-\\x20]*$"
                    }
                  },
                  "required": [
                    "type"
                  ]
                },
                "then": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "campaign_transaction"
                    },
                    "campaign": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                    },
                    "quest": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                    },
                    "transaction": {
                      "type": "string",
                      "maxLength": 256,
                      "pattern": "^[a-z0-9][a-z0-9_./-]{0,255}$"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "unarranged",
                        "negotiated",
                        "payment_pending",
                        "paid",
                        "unpaid"
                      ]
                    }
                  },
                  "required": [
                    "campaign",
                    "quest",
                    "transaction",
                    "state"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "type": "array"
          },
          "then": {
            "items": {
              "$ref": "#/$defs/campaign_transaction_fields"
            }
          }
        }
      ]
    },
    "campaign_companion_fields": {
      "allOf": [
        {
          "if": {
            "type": "object"
          },
          "then": {
            "additionalProperties": {
              "$ref": "#/$defs/campaign_companion_fields"
            },
