    "extra_per_player": {
      "type": "integer",
      "minimum": 0
    },
    "max_party_size": {
      "type": "integer",
      "minimum": 1
    },
    "placement_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "spawn_radius": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "spawn_mode": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "group",
        "near_player",
        "fixed",
        "raid_waves"
      ]
    },
    "wave_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "wave_interval_ticks": {
      "type": "integer",
      "minimum": 0
    },
    "wave_trigger": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "all_defeated",
        "timer"
      ]
    },
    "boss_bar": {
      "type": "boolean"
    },
    "location_message": {
      "type": "string",
      "minLength": 1
    },
    "respawn_policy": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "never",
        "missing_if_loaded",
        "until_first_defeat"
      ]
    },
    "cleanup_policy": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "remove_survivors",
        "preserve_in_world"
      ]
    },
    "completion_condition": {
      "type": "string",
      "minLength": 1,
      "enum": [
        "all_defeated",
        "all_gone"
      ]
    }
  }
