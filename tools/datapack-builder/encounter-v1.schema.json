{
  "type": "object",
  "title": "Controlled encounter template v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jeven.dev/villager-retaliation/schema/encounter-v1.schema.json",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "members"
  ],
  "properties": {
    "schema": {
      "const": "villagerretaliation:encounter/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "controller": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "enum": [
        "villagerretaliation:controlled"
      ]
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "title": "Encounter member",
        "additionalProperties": false,
        "required": [
          "entity"
        ],
        "properties": {
          "entity": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "equipment": {
            "type": "object",
            "title": "Equipment by slot",
            "additionalProperties": false,
            "properties": {
              "mainhand": {
                "type": "object",
                "title": "Equipped item",
                "additionalProperties": false,
                "required": [
                  "item"
                ],
                "properties": {
                  "item": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 99
                  },
                  "enchantments": {
                    "type": "object",
                    "title": "Enchantment levels",
                    "propertyNames": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 255
                    }
                  },
                  "drop_chance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              },
              "offhand": {
                "type": "object",
                "title": "Equipped item",
                "additionalProperties": false,
