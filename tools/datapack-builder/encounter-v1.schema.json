                      "minLength": 1,
                      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
                    },
                    "additionalProperties": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 255
                    }
                  },
                  "drop_chance": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "scene_actions": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "title": "Safe wave scene action",
              "additionalProperties": false,
              "required": [
                "id",
                "type",
                "text"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
                },
                "type": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "notification",
                    "dialogue"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512
                }
              }
            },
            "maxItems": 32
          },
          "dialogue_hook": {
            "type": "object",
            "title": "Wave dialogue hook",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      },
      "maxItems": 32
    },
    "extra_per_player": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
