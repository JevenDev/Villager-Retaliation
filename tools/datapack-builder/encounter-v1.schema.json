      "minimum": 1,
      "maximum": 16
    },
    "placement_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "spawn_radius": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
