{
  "schema": "villagerretaliation:story_fragments/v1",
  "libraries": [
    "common.json"
  ],
  "fragments": {
    "campaign_fixture:role_exchange": {
      "parameters": {
        "id": "string",
        "role": "string",
        "text": "string"
      },
      "value": {
        "id": {
          "$arg": "id"
        },
        "speaker": {
          "type": "role",
          "role": {
            "$arg": "role"
          }
        },
        "text": {
          "$use": "campaign_fixture:text",
          "args": {
            "key": {
              "$arg": "text"
            }
          }
        }
      }
    },
    "campaign_fixture:opening": {
      "parameters": {
        "role": "string",
        "greeting": "string",
        "question": "string"
      },
      "value": [
        {
          "id": "mentor",
          "speaker": {
            "type": "role",
            "role": {
              "$arg": "role"
            }
          },
          "text": {
            "$use": "campaign_fixture:text",
            "args": {
              "key": {
                "$arg": "greeting"
              }
            }
          },
          "camera": {
            "target": "speaker",
            "zoom": 0.2
          },
          "voices": {
            "en_us": "minecraft:entity.villager.ambient"
          }
        },
        {
          "id": "player",
          "speaker": {
            "type": "player"
          },
          "text": {
            "$use": "campaign_fixture:text",
            "args": {
              "key": {
                "$arg": "question"
              }
            }
          },
          "camera": {
            "target": "character",
            "zoom": 0
          }
        }
      ]
    }
  }
}
