{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://villagerretaliation.dev/schemas/builder-structures.schema.json",
  "title": "Complete builder structure catalog",
  "type": "object",
  "properties": {
    "replace": { "type": "boolean" },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } }
  },
  "required": ["entries"],
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "ingredient": {
      "type": "object",
      "properties": {
        "item": { "$ref": "#/$defs/id" },
        "tag": { "$ref": "#/$defs/id" },
        "count": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      },
      "required": ["count"],
      "oneOf": [{ "required": ["item"] }, { "required": ["tag"] }],
      "additionalProperties": false
    },
    "cost": {
      "oneOf": [
        {
          "type": "object",
          "properties": { "mode": { "const": "exact" } },
          "required": ["mode"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": { "const": "simplified" },
            "materials": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/ingredient" } }
          },
          "required": ["mode", "materials"],
          "additionalProperties": false
        }
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "structure": { "$ref": "#/$defs/id" },
        "structure_id": { "$ref": "#/$defs/id" },
        "structureId": { "$ref": "#/$defs/id" },
        "structures": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "category": { "type": "string" },
        "house_size": { "enum": ["small", "medium", "large"] },
        "label": { "type": "string" },
        "base_cost": { "type": "integer", "minimum": 0 },
        "baseCost": { "type": "integer", "minimum": 0 },
        "cost": { "type": "integer", "minimum": 0 },
        "construction_cost": { "$ref": "#/$defs/cost" },
        "enabled": { "type": "boolean" },
        "remove": { "type": "boolean" }
      },
      "anyOf": [{ "required": ["id"] }, { "required": ["structure"] }, { "required": ["structure_id"] }, { "required": ["structureId"] }, { "required": ["structures"] }],
      "additionalProperties": false
    }
  }
}
