{
  "schema": "villagerretaliation:quest/v2",
  "id": "example_template:first_steps",
  "metadata": {
    "title": {
      "key": "#metadata.title"
    },
    "description": {
      "key": "#metadata.description"
    },
    "questline": "example_template",
    "tags": [
      "example",
      "group.example"
    ]
  },
  "provider": {
    "type": "villagerretaliation:villager"
  },
  "availability": {
    "repeatable": false,
    "max_completions": 1,
    "locked_to_villager": true
  },
  "entry_stage": "started",
  "stages": [
    {
      "id": "started",
      "objectives": [
        {
          "id": "bring_paper",
          "type": "item_check",
          "item": "minecraft:paper",
          "count": 1,
          "tracker": {
            "text": {
              "key": "#stage.started.objective.bring_paper.tracker.text"
            },
            "complete_text": {
              "key": "#stage.started.objective.bring_paper.tracker.complete_text"
            },
            "show_progress": true,
            "progress": 0.75
          }
        }
      ],
      "dialogue": {
        "offer": {
          "label": {
            "key": "#stage.started.dialogue.offer.label"
          },
          "request": "question",
          "lines": {
            "key": "#stage.started.dialogue.offer.lines"
          },
          "responses": [
            {
              "id": "accept",
              "label": {
                "key": "#stage.started.dialogue.offer.response.accept.label"
              },
              "scene": "start_quest"
            }
          ]
        },
        "turn_in": {
          "label": {
            "key": "#stage.started.dialogue.turn_in.label"
          },
          "request": "question",
          "lines": {
            "key": "#stage.started.dialogue.turn_in.lines"
          },
          "responses": [
            {
              "id": "complete",
              "label": {
                "key": "#stage.started.dialogue.turn_in.response.complete.label"
              },
              "scene": "complete_quest"
            }
          ]
        }
      },
      "scenes": [
        {
          "id": "start_quest",
          "actions": [
            {
              "type": "quest",
              "action": "start",
              "lines": {
                "started": {
                  "key": "#stage.started.scene.start_quest.action.start.lines.started"
                },
                "unavailable": {
                  "key": "#stage.started.scene.start_quest.action.start.lines.unavailable"
                }
              }
            }
          ]
        },
        {
          "id": "complete_quest",
          "actions": [
            {
              "type": "quest",
              "action": "turn_in",
              "lines": {
                "completed": {
                  "key": "#stage.started.scene.complete_quest.action.turn_in.lines.completed"
                },
                "missing_objectives": {
                  "key": "#stage.started.scene.complete_quest.action.turn_in.lines.missing_objectives"
                },
                "unavailable": {
                  "key": "#stage.started.scene.complete_quest.action.turn_in.lines.unavailable"
                }
              }
            }
          ]
        }
      ]
    }
  ],
  "ui": {
    "tracker_text": {
      "key": "#ui.tracker_text"
    },
    "icon": "minecraft:paper"
  },
  "localization_prefix": "example_template.quest.first_steps"
}
