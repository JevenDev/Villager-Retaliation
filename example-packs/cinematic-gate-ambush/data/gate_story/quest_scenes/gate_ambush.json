{
  "schema": "villagerretaliation:scene/v1",
  "id": "gate_story:gate_ambush",
  "definition_version": 1,
  "metadata": {
    "title": "Mara and Tovin defend the gate",
    "example": "provider unload and encounter recovery"
  },
  "ownership": "party",
  "entry_step": "opening",
  "timeout_ticks": 2400,
  "failure_policy": "block_for_repair",
  "cancellation_policy": "cancel_scene",
  "cleanup_policy": "all_owned",
  "actors": [
    {
      "alias": "player",
      "type": "villagerretaliation:player",
      "required": true,
      "capabilities": ["villagerretaliation:capability/live_entity"],
      "binding_source": "owner_player",
      "replacement_policy": "fixed",
      "missing_actor_policy": "wait_until_timeout",
      "death_policy": "block",
      "timeout_ticks": 600
    },
    {
      "alias": "captain_mara",
      "type": "villagerretaliation:villager",
      "required": true,
      "capabilities": ["villagerretaliation:capability/pathfinding", "villagerretaliation:capability/dialogue"],
      "binding_source": "quest_provider",
      "replacement_policy": "fixed",
      "missing_actor_policy": "wait_until_timeout",
      "death_policy": "fail",
      "filters": { "display_name": "Captain Mara" },
      "timeout_ticks": 1200
    },
    {
      "alias": "scout_tovin",
      "type": "villagerretaliation:villager",
      "required": false,
      "capabilities": ["villagerretaliation:capability/pathfinding", "villagerretaliation:capability/dialogue"],
      "binding_source": "unbound",
      "replacement_policy": "operator_rebindable",
      "missing_actor_policy": "skip",
      "death_policy": "continue_with_snapshot",
      "filters": { "display_name": "Scout Tovin" }
    },
    {
      "alias": "gate",
      "type": "villagerretaliation:position",
      "required": false,
      "binding_source": "marker",
      "binding": "village_gate",
      "replacement_policy": "fixed",
      "missing_actor_policy": "skip",
      "filters": { "dimension": "minecraft:overworld", "x": "0", "y": "64", "z": "12" }
    }
  ],
  "steps": [
    {
      "id": "opening",
      "type": "villagerretaliation:dialogue",
      "actors": ["captain_mara", "scout_tovin"],
      "data": { "text": "Mara: Tovin and I will meet you at the gate." },
      "next": "move_mara",
      "failure_step": "failed"
    },
    {
      "id": "move_mara",
      "type": "villagerretaliation:move_actor",
      "actors": ["captain_mara"],
      "data": {
        "actor": "captain_mara",
        "target_actor": "gate",
        "speed": 0.6,
        "arrival_distance": 1.5,
        "poll_ticks": 5,
        "timeout_ticks": 900,
        "path_failure_policy": "block",
        "allow_teleport": false
      },
      "next": "move_tovin",
      "failure_step": "failed"
    },
    {
      "id": "move_tovin",
      "type": "villagerretaliation:move_actor",
      "actors": ["scout_tovin"],
      "data": { "actor": "scout_tovin", "target_actor": "gate", "timeout_ticks": 900, "path_failure_policy": "block" },
      "next": "persisted_pause",
      "failure_step": "failed"
    },
    {
      "id": "persisted_pause",
      "type": "villagerretaliation:wait_ticks",
      "data": { "ticks": 80 },
      "next": "approach_choice"
    },
    {
      "id": "approach_choice",
      "type": "villagerretaliation:scene_branch",
      "data": {
        "branches": [
          {
            "transition": "bold",
            "conditions": [
              { "type": "selected_choice", "quest": "gate_story:gate_ambush", "scene_path": "stage.briefing.scene.bold_confirm", "response": "bold" }
            ]
          }
        ],
        "default_transition": "cautious"
      },
      "transitions": { "bold": "bold_line", "cautious": "cautious_line" },
      "failure_step": "failed"
    },
    {
      "id": "bold_line",
      "type": "villagerretaliation:dialogue",
      "actors": ["captain_mara"],
      "data": { "text": "Mara: Shields high. We meet them head-on." },
      "next": "start_ambush"
    },
    {
      "id": "cautious_line",
      "type": "villagerretaliation:dialogue",
      "actors": ["captain_mara", "scout_tovin"],
      "data": { "text": "Tovin circles wide while Mara holds the road." },
      "next": "scouting_wait"
    },
    {
      "id": "scouting_wait",
      "type": "villagerretaliation:wait_ticks",
      "data": { "ticks": 40 },
      "next": "start_ambush"
    },
    {
      "id": "start_ambush",
      "type": "villagerretaliation:start_encounter",
      "data": { "template": "gate_story:gate_ambush", "anchor_actor": "captain_mara", "difficulty": "normal" },
      "next": "fight",
      "failure_step": "failed"
    },
    {
      "id": "fight",
      "type": "villagerretaliation:wait_encounter",
      "data": { "encounter_step": "start_ambush" },
      "next": "cleanup",
      "failure_step": "failed"
    },
    {
      "id": "cleanup",
      "type": "villagerretaliation:cleanup_encounter",
      "data": { "encounter_step": "start_ambush", "force_remove": false },
      "next": "complete_quest",
      "failure_step": "failed"
    },
    {
      "id": "complete_quest",
      "type": "villagerretaliation:quest_transition",
      "data": { "quest": "gate_story:gate_ambush", "target": "complete" },
      "next": "completed",
      "failure_step": "failed"
    },
    { "id": "completed", "type": "villagerretaliation:scene_complete" },
    { "id": "failed", "type": "villagerretaliation:scene_fail" }
  ]
}
