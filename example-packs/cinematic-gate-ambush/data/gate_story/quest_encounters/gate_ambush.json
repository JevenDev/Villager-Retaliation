{
  "schema": "villagerretaliation:encounter/v1",
  "id": "gate_story:gate_ambush",
  "version": 3,
  "controller": "villagerretaliation:controlled",
  "waves": [
    {
      "id": "roadside_dead",
      "members": [{ "entity": "minecraft:zombie", "count": 2 }],
      "boss_bar_title": "Gate Ambush - Roadside Dead"
    },
    {
      "id": "gatebreaker_wave",
      "members": [
        { "entity": "minecraft:zombie", "count": 1 },
        {
        "id": "gatebreaker",
        "entity": "minecraft:zombie",
        "count": 1,
        "custom_name": "Gatebreaker",
        "name_visible": true,
        "health": 30,
        "attack_damage": 6,
        "boss": true,
        "boss_bar_color": "red",
        "boss_bar_overlay": "progress"
        }
      ],
      "delay_ticks": 40,
      "trigger": "all_defeated",
      "boss_bar_title": "Gate Ambush - Gatebreaker"
    }
  ],
  "spawn_mode": "raid_waves",
  "spawn_points": [
    { "id": "west_road", "marker": "gate", "offset_x": -7, "offset_z": 5, "weight": 2 },
    { "id": "east_road", "marker": "gate", "offset_x": 7, "offset_z": 5, "weight": 1 }
  ],
  "spawn_selection": "weighted",
  "allies": [
    {
      "id": "captain_mara",
      "actor": "captain_mara",
      "invulnerable": true,
      "cleanup_policy": "preserve",
      "affects_completion": true
    }
  ],
  "phases": [
    {
      "id": "gatebreaker_arrives",
      "trigger": { "type": "wave_started", "wave": "gatebreaker_wave" },
      "actions": [
        { "id": "arrival_line", "type": "dialogue", "text": "Mara: Gatebreaker! Keep it away from the gate!" }
      ]
    },
    {
      "id": "gatebreaker_falls",
      "trigger": { "type": "elite_defeated", "member": "gatebreaker" },
      "actions": [
        { "id": "remember_gatebreaker", "type": "fact", "scope": "player", "tag": "gate_story:gatebreaker_defeated" }
      ]
    }
  ],
  "extra_per_player": 1,
  "max_party_size": 4,
  "placement_attempts": 16,
  "spawn_radius": 8,
  "area": {
    "radius": 24,
    "vertical_radius": 12,
    "leave_behavior": "pause",
    "leave_timeout_ticks": 200,
    "mob_behavior": "teleport",
    "mob_timeout_ticks": 100
  },
  "respawn_policy": "missing_if_loaded",
  "cleanup_policy": "remove_survivors",
  "completion_objectives": {
    "mode": "all",
    "objectives": [
      { "id": "clear_ambush", "type": "all_defeated" },
      { "id": "break_gatebreaker", "type": "defeat_leader", "member": "gatebreaker" }
    ]
  }
}
